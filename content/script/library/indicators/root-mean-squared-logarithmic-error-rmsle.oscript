version 1
study("Root Mean Squared Logarithmic Error (RMSLE)", precision = 4)

source = input(close, "Source")
period = input(100, "Period", min = 1, max = 4000, step = 1)

// The reference is an exponential mean seeded with the simple average of its
// first period values, so it has no value through the warmup.
reference = ema(source, period)

// The squared gap between log(1 + price) and log(1 + reference). A bar where
// either side is at or below -1 has no logarithm and is left out.
logSquaredError = none
if not isNone(source) and not isNone(reference) and 1 + source > 0 and 1 + reference > 0
    diff = log(1 + source) - log(1 + reference)
    logSquaredError = diff * diff

// Mean of the squared log gaps over the last period bars (at most 4000),
// counting only the bars that carry one, then its square root.
window = min(period, 4000)
msle = avgSkip(logSquaredError, window)
rmsle = msle >= 0 ? sqrt(msle) : none

plot(rmsle, "RMSLE", #ef5350, width = 2, style = "area")
plot(reference, "EMA", #ffeb3b, width = 1, overlay = true)
