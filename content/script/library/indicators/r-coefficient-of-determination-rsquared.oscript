version 1
study("R² Coefficient of Determination (RSQUARED)", precision = 4)

source = input(close, "Source")
period = input(100, "Period", min = 1, max = 4000, step = 1)

// The total and the count of the present values among the last p bars.
// Before p bars have passed the window is everything so far, so both answer
// from the first bar.
fn windowSum(x, p) =>
    var running = 0.0
    if not isNone(x)
        running = running + x
    rolled = sumSkip(x, p)
    bar.index < p - 1 ? running : rolled

fn windowCount(x, p) =>
    var n = 0
    if not isNone(x)
        n = n + 1
    rolled = countPresent(x, p)
    bar.index < p - 1 ? n : rolled

// The model is an exponential mean seeded with the simple average of its
// first period values, so it has no value through the warmup.
model = ema(source, period)
window = min(period, 4000)

// The mean of the window, which holds this bar too: an expanding mean until
// the window fills, a rolling one after.
srcCount = windowCount(source, window)
srcSum = windowSum(source, window)
srcMean = srcCount > 0 ? srcSum / srcCount : source

squaredResidual = (source - model) * (source - model)
totalSquares = (source - srcMean) * (source - srcMean)

// Window totals of each. With none present the bar's own value stands in.
rssCount = windowCount(squaredResidual, window)
rssSum = windowSum(squaredResidual, window)
tssCount = windowCount(totalSquares, window)
tssSum = windowSum(totalSquares, window)
rss = rssCount > 0 ? rssSum : squaredResidual
tss = tssCount > 0 ? tssSum : totalSquares

// One minus the share of variation the model leaves unexplained. A window
// with no variation at all reads as 1.
score = isNone(rss) or isNone(tss) ? none : tss != 0 ? 1 - rss / tss : 1.0

plot(score, "R²", #ffeb3b, width = 2, style = "area")
plot(model, "EMA", #ffeb3b, width = 1, overlay = true)
