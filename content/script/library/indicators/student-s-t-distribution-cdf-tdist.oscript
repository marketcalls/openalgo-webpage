version 1
study("Student's t-Distribution CDF (TDIST)", precision = 4)

source = input(close, "Source")
period = input(50, "Period", min = 1, max = 5000, step = 1)
df = input(5.0, "Degrees of Freedom", min = 0.1, max = 1000, step = 0.1, tooltip = "Tail weight. 1 is Cauchy with very heavy tails, large values approach the normal distribution.")

// Natural log of the Gamma function: a nine-term series approximation with g = 7
// and the reflection formula below 0.5.
fn lnGamma(z) =>
    zz = z < 0.5 ? 1.0 - z : z - 1.0
    ser = 0.99999999999980993
    ser = ser + 676.5203681218851 / (zz + 1)
    ser = ser - 1259.1392167224028 / (zz + 2)
    ser = ser + 771.32342877765313 / (zz + 3)
    ser = ser - 176.61502916214059 / (zz + 4)
    ser = ser + 12.507343278686905 / (zz + 5)
    ser = ser - 0.13857109526572012 / (zz + 6)
    ser = ser + 9.9843695780195716e-6 / (zz + 7)
    ser = ser + 1.5056327351493116e-7 / (zz + 8)
    tg = zz + 7.0 + 0.5
    lnG = 0.9189385332046727 + log(tg) * (zz + 0.5) - tg + log(ser)
    z < 0.5 ? log(math.pi / math.sin(math.pi * z)) - lnG : lnG

// The regularized incomplete beta function I_x(a, b) by a continued
// fraction, flipped to 1 - I_(1-x)(b, a) where that converges faster. The
// fraction starts at its first even term with f seeded at 1, so its leading
// odd term is not applied: the result runs a few percent from the textbook
// value and pushes the plotted probability slightly towards the extremes.
fn betaReg(xv, a, b) =>
    if not (xv > 0.0)
        return 0.0
    if xv >= 1.0
        return 1.0
    flipped = xv > (a + 1.0) / (a + b + 2.0)
    xx = flipped ? 1.0 - xv : xv
    aa = flipped ? b : a
    bb = flipped ? a : b
    logPfx = aa * log(xx) + bb * log(1.0 - xx) - log(aa) - lnGamma(aa) - lnGamma(bb) + lnGamma(aa + bb)
    pfx = exp(logPfx)
    tiny = 1e-30
    f = 1.0 + tiny
    cc = f
    dd = 0.0
    for m = 1 to 200
        m2 = 2.0 * m
        numEven = (m * (bb - m) * xx) / ((aa + m2 - 1.0) * (aa + m2))
        dd = 1.0 + numEven * dd
        if abs(dd) < tiny
            dd = tiny
        dd = 1.0 / dd
        cc = 1.0 + numEven / cc
        if abs(cc) < tiny
            cc = tiny
        f = f * cc * dd
        numOdd = (0 - (aa + m) * (aa + bb + m) * xx) / ((aa + m2) * (aa + m2 + 1.0))
        dd = 1.0 + numOdd * dd
        if abs(dd) < tiny
            dd = tiny
        dd = 1.0 / dd
        cc = 1.0 + numOdd / cc
        if abs(cc) < tiny
            cc = tiny
        delta = cc * dd
        f = f * delta
        if abs(delta - 1.0) < 1e-10
            break
    raw = pfx * f
    flipped ? 1.0 - raw : raw

// The window's high and low. Until a full window exists, the bars before the
// first one count as 0, so the range is stretched to include zero.
s = orElse(source, 0)
hiFull = highest(source, period)
loFull = lowest(source, period)
var prefixHi = none
var prefixLo = none
prefixHi = isNone(prefixHi) ? s : max(prefixHi, s)
prefixLo = isNone(prefixLo) ? s : min(prefixLo, s)
full = bar.index >= period - 1 and not isNone(hiFull) and not isNone(loFull)
hi = full ? hiFull : period <= 1 ? s : max(prefixHi, 0)
lo = full ? loFull : period <= 1 ? s : min(prefixLo, 0)

// Position in the range mapped onto a t-statistic from -3 to 3, then read
// through the Student's t cumulative distribution with df degrees of freedom.
spanHL = hi - lo
x = spanHL == 0 ? 0.5 : (s - lo) / spanHL
t = (x - 0.5) * 6.0
ibeta = betaReg(df / (df + t * t), df / 2.0, 0.5)
value = t >= 0.0 ? 1.0 - 0.5 * ibeta : 0.5 * ibeta

plot(value, "TDIST", #ffeb3b, width = 2)
level(0.5, "Midline", #787b86, style = "solid")
level(0.95, "Upper", #ef5350, style = "dashed")
level(0.05, "Lower", #4caf50, style = "dashed")
