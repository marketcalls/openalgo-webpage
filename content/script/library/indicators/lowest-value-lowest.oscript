version 1
study("Lowest Value (LOWEST)", overlay = true, precision = 2)

period = input(14, "Period", min = 1, max = 5000, step = 1)
source = input(close, "Source")

// A missing source value counts as zero and still enters the window.
value = orElse(source, 0)

// Until the window is full the line is the lowest value seen so far, so it
// answers from the first bar. After that it is the lowest of the last
// period bars.
var runningLow = none
runningLow = isNone(runningLow) ? value : min(runningLow, value)
windowLow = lowest(value, period)
result = bar.index < period - 1 ? runningLow : windowLow

plot(result, "Lowest", #ffeb3b, width = 2)
