version 1
study("Volume Force (VF)", precision = 2)

length = input(14, "Smoothing Period", min = 1, max = 5000, step = 1)

// Each bar's price change times its volume. The first bar compares the close
// with itself, so it has no force.
prevClose = bar.index > 0 ? close[1] : close
rawVf = (close - prevClose) * orElse(volume, 0)

// An exponential mean that starts from zero, divided by the weight it has
// gathered so far, so the early bars are not pulled towards zero. Once the
// missing weight is negligible the correction stops.
smoothing = 2 / (length + 1)
var emaVal = 0.0
var e = 1.0
var warmup = true
emaVal = smoothing * (rawVf - emaVal) + emaVal
if warmup
    e = e * (1 - smoothing)
vfValue = warmup ? (1 - e > 0 ? emaVal / (1 - e) : emaVal) : emaVal
warmup = warmup and e > 1e-10

plot(vfValue, "Volume Force", #ffeb3b, width = 2)
level(0, "Zero Line", #787b86, style = "dashed")

// Green behind positive force, red behind zero or negative force.
background(vfValue > 0 ? fade(#26a69a, 87) : fade(#ef5350, 87))
