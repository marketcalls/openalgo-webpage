version 1
study("Yang-Zhang Volatility (YZV)", precision = 4)

length = input(20, "Length", min = 1, max = 5000, step = 1, tooltip = "The lookback period for smoothing Yang-Zhang daily variance estimates.")

ratioN = length <= 1 ? 1 : (length + 1) / (length - 1)
kYz = 0.34 / (1.34 + ratioN)
rmaAlpha = 1 / length

// The previous close, or this bar's open on the first bar.
pc = isNone(close[1]) ? open : close[1]
valid = open > 0 and high > 0 and low > 0 and close > 0 and pc > 0

// The gap from the previous close, the open-to-close move and the
// Rogers-Satchell intraday term, all as log ratios.
ro = log(open / pc)
rc = log(close / open)
rh = log(high / open)
rl = log(low / open)
dailyVariance = ro * ro + kYz * rc * rc + (1 - kYz) * (rh * (rh - rc) + rl * (rl - rc))

// A Wilder average of the variance, set to the estimate itself on the first
// bar and otherwise carried from a zero start. It is divided by (1 - e), where
// e is the weight of the start, while e is above a tiny threshold; then its
// square root. A bar without a valid estimate leaves the average untouched.
var rawRma = 0.0
var eComp = 1.0
smoothed = none
if valid and not isNone(dailyVariance)
    rawRma = bar.index == 0 ? dailyVariance : (rawRma * (length - 1) + dailyVariance) / length
    eComp = (1 - rmaAlpha) * eComp
    d = 1 - eComp
    smoothed = eComp > 1e-10 and d != 0 ? rawRma / d : rawRma

yzv = smoothed >= 0 ? sqrt(smoothed) : none

plot(yzv, "YZV", #ffeb3b, width = 2)
