version 1
study("Mean Arctangent Absolute Percentage Error", precision = 4, format = "percent")

length = input(14, "Length", min = 1, max = 5000, step = 1)
actual = input(close, "Actual")
predicted = input(open, "Predicted")

// An absent value on either side reads as zero.
a = orElse(actual, 0)
p = orElse(predicted, 0)
absActual = abs(a)
absError = abs(a - p)

// The arctangent bounds the percentage error at pi / 2. An actual value at
// zero counts as the largest possible error.
atanError = absActual > 1e-10 ? math.atan(absError / absActual) : math.pi / 2
maape = sma(atanError, length)

plot(maape, "MAAPE", #ffeb3b, width = 2)
level(0, "Zero", #787b86, style = "dashed")
level(math.pi / 2, "Max (pi/2)", #ff5252, style = "dashed")
