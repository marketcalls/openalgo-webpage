version 1
study("Exponential Transformation (EXP)", precision = 4)

source = input(close, "Source")

// e to the power of the source, bar by bar. Above about 709 the result is
// too large to hold, and exp gives no value there, so those bars are left
// empty rather than infinite.
plot(exp(source), "Exponential Transformation", #ffeb3b, width = 2)
