version 1
study("Ehlers 3-Pole Super Smoother Filter (SSF3)", overlay = true, precision = 2)

length = input(20, "Length", min = 1, max = 5000, step = 1)
source = input(close, "Source")

// Three poles placed to cancel the filter's own ringing.
p = max(1, floor(length))
a1 = exp(-math.pi / p)
b1 = 2 * a1 * math.cos(sqrt(3) * math.pi / p)
c1 = a1 * a1
coef2 = b1 + c1
coef3 = -(c1 + b1 * c1)
coef4 = c1 * c1
coef1 = 1 - coef2 - coef3 - coef4

// Every value not yet available reads as the newest price that is, so the
// filter answers from the first bar.
ssrc = orElse(source, source[1])
src1 = orElse(source[1], ssrc)
src2 = orElse(source[2], src1)
src3 = orElse(source[3], src2)

var out1 = none
var out2 = none
var out3 = none
filt1 = orElse(out1, src1)
filt2 = orElse(out2, src2)
filt3 = orElse(out3, src3)

ssf = coef1 * ssrc + coef2 * filt1 + coef3 * filt2 + coef4 * filt3

// The outputs move along every bar, a missing one included.
out3 = out2
out2 = out1
out1 = ssf

plot(ssf, "SSF3", #ffeb3b, width = 2)
