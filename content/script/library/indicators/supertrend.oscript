version 1
study("Supertrend", overlay = true, precision = 2)

atrPeriod = input(10, "ATR Length", min = 1)
factor = input(3.0, "Factor", min = 0.01, step = 0.01)

// Bands around the bar's midpoint, `factor` average true ranges away. The
// average true range is Wilder's average of the true range, seeded with a
// simple average; on the first bar the true range is the high minus the low.
atrValue = atr(atrPeriod)
rawUpper = hl2 + factor * atrValue
rawLower = hl2 - factor * atrValue

// Each band keeps its previous value unless price gives it room: the lower
// band only rises while the close stays above it, and the upper band only
// falls while the close stays below it. A band that does not exist yet reads
// as zero, and a comparison with an absent value is false.
var lowerState = none
var upperState = none
var lineState = none
prevLower = orElse(lowerState, 0)
prevUpper = orElse(upperState, 0)
prevLine = lineState
lowerBand = rawLower > prevLower or close[1] < prevLower ? rawLower : prevLower
upperBand = rawUpper < prevUpper or close[1] > prevUpper ? rawUpper : prevUpper

// -1 is an uptrend and 1 a downtrend. The line flips to the other band when
// the close crosses the band it is on.
direction = isNone(atrValue[1]) ? 1 : prevLine == prevUpper ? (close > upperBand ? -1 : 1) : (close < lowerBand ? 1 : -1)
line = direction == -1 ? lowerBand : upperBand
lowerState = lowerBand
upperState = upperBand
lineState = line

stLine = bar.isFirst ? none : line
bodyMiddle = bar.isFirst ? none : (open + close) / 2

upTrend = plot(direction < 0 ? stLine : none, "Up Trend", #4CAF50)
downTrend = plot(direction < 0 ? none : stLine, "Down Trend", #FF5252)
// The body's midpoint only anchors the two shaded areas, so it is drawn fully
// transparent.
middle = plot(bodyMiddle, "Body Middle", rgba(0, 0, 0, 0))

fill(middle, upTrend, rgba(76, 175, 80, 0.1))
fill(middle, downTrend, rgba(255, 82, 82, 0.1))

if direction[1] > direction
    alert("The Supertrend value switched from Downtrend to Uptrend", id = "downtrend-to-uptrend", title = "Downtrend to Uptrend")
if direction[1] < direction
    alert("The Supertrend value switched from Uptrend to Downtrend", id = "uptrend-to-downtrend", title = "Uptrend to Downtrend")
if direction[1] != direction
    alert("The Supertrend value switched from Uptrend to Downtrend or vice versa", id = "trend-change", title = "Trend Change")
