version 1
study("Futures Setups", overlay = true, precision = 2)

// A multi-timeframe setup engine. It registers Fair Value Gaps and Order
// Blocks from the chart timeframe and from 5, 15, 30, 60 and 240 minute bars
// built out of the chart's own bars, flips invalidated ones into Inversion
// FVGs and Breaker Blocks, scores every open zone out of 100 across six
// categories (zone authority, multi-timeframe overlap, structure, liquidity,
// market context and session behaviour), and turns the best qualifying touch
// into a trade plan with a stop and 1R, 1.5R and 2R objectives.
//
// The higher timeframe bars are built from the chart's bars, bucketed from
// the 18:00 futures session open in the session timezone, and only closed
// buckets are read, so nothing looks ahead. The engine is idle until the
// symbol and timeframe gates allow it: NQ and ES futures on a one minute
// chart by default, or any instrument and up to five minutes when the two
// switches in Quick Start are on. The regime panel works on any chart.

// ---- 01 Quick Start ---------------------------------------------------------
indicatorEnabled = input(true, "Enable indicator", group = "01 Quick Start")
allowUnsupportedSymbols = input(false, "Allow symbols other than NQ/ES", tooltip = "The engine is tuned for NQ and ES futures. Switch this on to run it on any other instrument.", group = "01 Quick Start")
allowNonOneMinuteCharts = input(false, "Allow chart timeframes above 1 minute", tooltip = "The execution engine is optimized for the 1-minute chart. Higher chart timeframes are diagnostic only unless this option is enabled.", group = "01 Quick Start")
sessionTimezone = input("America/New_York", "Session timezone", group = "01 Quick Start")
futuresSession = input("1800-1700:1234567", "Futures session", group = "01 Quick Start")
overnightSession = input("1800-0930:1234567", "Overnight session", group = "01 Quick Start")
rthSession = input("0930-1600:23456", "Regular trading hours", group = "01 Quick Start")
signalSession = input("0800-1600:23456", "Signal window", tooltip = "Default covers the primary New York intraday window. Expand it when you intentionally want overnight or evening signals.", group = "01 Quick Start")
maximumActiveTrades = input(3, "Maximum active trades", min = 1, max = 3, step = 1, group = "01 Quick Start")
showPastTrades = input(false, "Show past trades", group = "01 Quick Start")
pastTradeRetentionHours = input(22, "Past-trade retention hours", min = 1, max = 72, step = 1, group = "01 Quick Start")
completedRetentionMinutes = input(5, "Default completed-trade retention", min = 0, max = 120, step = 1, group = "01 Quick Start")

