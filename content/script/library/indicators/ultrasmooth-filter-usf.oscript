version 1
study("Ultrasmooth Filter (USF)", overlay = true, precision = 2)

length = input(20, "Length", min = 1, max = 5000, step = 1)
source = input(close, "Source")

len = max(1, floor(length))

// The same two-pole design as a supersmoother, with the price fed through a
// momentum term built from its two previous values.
arg = sqrt(2.0) * math.pi / len
expArg = exp(-arg)
c2 = 2.0 * expArg * math.cos(arg)
c3 = -expArg * expArg
c1 = (1.0 + c2 - c3) / 4.0

// Missing inputs read as the nearest value that exists.
ssrc = orElse(source, source[1])
src1 = orElse(source[1], ssrc)
src2 = orElse(source[2], src1)

// The two previous outputs, absent before they exist; until then the filter
// reads the price in their place.
var prev1 = none
var prev2 = none
us1 = orElse(prev1, src1)
us2 = orElse(prev2, src2)

usf = (1.0 - c1) * ssrc + (2.0 * c1 - c2) * src1 - (c1 + c3) * src2 + c2 * us1 + c3 * us2

prev2 = prev1
prev1 = usf

plot(usf, "UltraSmooth", #ffeb3b, width = 2)
