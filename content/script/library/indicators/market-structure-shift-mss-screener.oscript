version 1
study("Market Structure Shift (MSS) Screener", overlay = true, precision = 2)

// ---- Screener -----------------------------------------------------------------
scrMethod = input("Market Structure Shift", "Screening Method", options = ["Market Structure Shift", "Retracement to OTE / OB"], group = "Screener", tooltip = "Which event fills the table: the structure shift itself, or the retracement back into the shifted range.")
scrDirection = input("Both", "Direction", options = ["Both", "Bullish", "Bearish"], group = "Screener")
scrShowBull = input(true, "Only Bullish", group = "Screener")
scrShowBear = input(true, "Only Bearish", group = "Screener")
tblRows = input(16, "Display Rows", min = 0, max = 100, step = 1, group = "Screener")
tblPosition = input("bottom-left", "Table Position", options = ["top-left", "top-center", "top-right", "middle-left", "middle-center", "middle-right", "bottom-left", "bottom-center", "bottom-right"], group = "Screener")
tblSize = input("small", "Table Size", options = ["auto", "tiny", "small", "normal", "large", "huge"], group = "Screener")

// ---- Zig zag ------------------------------------------------------------------
bearShow = input(true, "Bearish", group = "Zig Zag")
bearShiftShow = input(true, "Bearish Shift", group = "Zig Zag")
bearRetShow = input(true, "Bearish Retracement", group = "Zig Zag")
bullShow = input(true, "Bullish", group = "Zig Zag")
bullShiftShow = input(true, "Bullish Shift", group = "Zig Zag")
bullRetShow = input(true, "Bullish Retracement", group = "Zig Zag")
zzPeriod = input(4, "Zig Zag Length", min = 2, max = 500, step = 1, group = "Zig Zag", tooltip = "A bar is a swing point when it is the highest or lowest of this many bars.")
zzSource = input("High/Low", "Source", options = ["High/Low", "Open/Close"], group = "Zig Zag")
zzShow = input(false, "Show Zig Zag", group = "Zig Zag")
boxTransp = input(75, "Box Transparency", min = 0, max = 100, step = 1, group = "Zig Zag", tooltip = "Transparency of the swing range box, 0 solid to 100 invisible.")

// ---- Additional filters -------------------------------------------------------
filterChoice = input("Percentage", "Filter Using", options = ["Multiplier", "Percentage"], group = "Additional Filters", tooltip = "Filters remove narrow swing displacements. Multiplier adapts to the timeframe; Percentage stays constant across all of them. Set Percentage to 0 for no filtering.")
filterMultiplier = input(2, "Multiplier", min = 1, max = 100, step = 0.1, group = "Additional Filters", tooltip = "The new swing displacement must be this many times the previous one.")
filterPercentage = input(0.7, "Percentage Above", min = 0, max = 100, step = 0.1, group = "Additional Filters", tooltip = "Filters liquidity displacement above the given percentage.")

// The palette.
posColor = #22AB94
negColor = #F7525F
bullSignalColor = #70CCBD
bearSignalColor = #FAA1A4
zzLineColor = #1E53E5
neutralColor = #B2B5BE

// Each family of drawings keeps at most this many events, newest first.
maxEvents = 500
maxZzPoints = 500

// ---- Swing points -------------------------------------------------------------
// The swing source is the candle body or the wicks.
useBody = zzSource == "Open/Close"
hiSrc = useBody ? max(open, close) : high
loSrc = useBody ? min(open, close) : low

// A bar is a swing extreme when it is the extreme of the last zzPeriod bars; a
// tie with an older bar still counts for this bar.
windowHigh = highest(hiSrc, zzPeriod)
windowLow = lowest(loSrc, zzPeriod)
ph = not isNone(windowHigh) and windowHigh == hiSrc ? hiSrc : none
pl = not isNone(windowLow) and windowLow == loSrc ? loSrc : none
hasPh = not isNone(ph)
hasPl = not isNone(pl)

// The swing direction: down on a lone swing low, up on a lone swing high.
var dir = 0
var prevDir = none
if hasPl and not hasPh
    dir = -1
else if hasPh and not hasPl
    dir = 1
dirChanged = not isNone(prevDir) and dir != prevDir
prevDir = dir

// The zig zag, oldest pivot first: a new pivot when the direction turns, else
// the newest pivot moves on when this bar extends it.
var pivPrice: array<number> = []
var pivIndex: array<number> = []
var pivTime: array<number> = []

if hasPh or hasPl
    value = dir == 1 ? ph : pl
    if not isNone(value)
        if dirChanged or size(pivPrice) == 0
            push(pivPrice, value)
            push(pivIndex, bar.index)
            push(pivTime, time)
            if size(pivPrice) > maxZzPoints
                shift(pivPrice)
                shift(pivIndex)
                shift(pivTime)
        else
            last = size(pivPrice) - 1
            lastPrice = element(pivPrice, last)
            if (dir == 1 and value > lastPrice) or (dir == -1 and value < lastPrice)
                set(pivPrice, last, value)
                set(pivIndex, last, bar.index)
                set(pivTime, last, time)

// The three swings the test reads. The window is the newest five pivots, and
// within it zz1 is the second newest, zz2 the one before and zz3 older still;
// with fewer than five pivots the window starts at the newest.
pivCount = size(pivPrice)
held = min(pivCount, 5)
k1 = held >= 4 ? pivCount - 1 - (held - 4) : none
k2 = held >= 3 ? pivCount - 1 - (held - 3) : none
k3 = held >= 2 ? pivCount - 1 - (held - 2) : none
zz1 = isNone(k1) ? none : element(pivPrice, k1)
zz2 = isNone(k2) ? none : element(pivPrice, k2)
zz3 = isNone(k3) ? none : element(pivPrice, k3)
t1 = isNone(k1) ? none : element(pivTime, k1)
t2 = isNone(k2) ? none : element(pivTime, k2)
t3 = isNone(k3) ? none : element(pivTime, k3)

swingsReady = not isNone(zz1) and not isNone(zz2) and not isNone(zz3)

// The displacement filter, by multiple of the previous swing or by percentage.
multiplier = max(1, filterMultiplier)
percentage = max(0, filterPercentage)
byMultiplier = filterChoice == "Multiplier"
filterOk = false
if swingsReady
    if byMultiplier
        filterOk = abs(zz1 - zz2) > abs(zz3 - zz2) * multiplier
    else if zz3 != 0
        filterOk = abs((zz3 - zz1) / zz3 * 100) > percentage

// The close crossing the middle swing.
prevZz2 = zz2[1]
crossReady = swingsReady and not isNone(prevZz2) and not isNone(close[1])
crossUnder2 = crossReady ? close < zz2 and close[1] >= prevZz2 : false
crossOver2 = crossReady ? close > zz2 and close[1] <= prevZz2 : false

bearCond = swingsReady ? zz1 > zz2 and zz1 > zz3 and zz2 < zz1 and zz2 < zz3 and zz3 < zz1 and zz3 > zz2 and close < zz1 and close < zz2 and close < zz3 and crossUnder2 and filterOk and bar.isConfirmed : false
bullCond = swingsReady ? zz1 < zz2 and zz1 < zz3 and zz2 > zz1 and zz2 > zz3 and zz3 > zz1 and zz3 < zz2 and close > zz1 and close > zz2 and close > zz3 and crossOver2 and filterOk and bar.isConfirmed : false

// One third of the way back into the broken range, held until the next shift.
var bearPrice = none
var bearAnchor = none
var bullPrice = none
var bullAnchor = none
heldBearPrice = bearPrice
heldBullPrice = bullPrice
if bearCond
    bearPrice = zz1 - (zz1 - zz2) / 3
    bearAnchor = t1
if bullCond
    bullPrice = zz1 + (zz2 - zz1) / 3
    bullAnchor = t1

// The high crossing up into the bearish level, the low crossing down into the
// bullish one.
bearRetCond = not isNone(bearPrice) and not isNone(heldBearPrice) and not isNone(high[1]) ? high > bearPrice and high[1] <= heldBearPrice and bar.isConfirmed : false
bullRetCond = not isNone(bullPrice) and not isNone(heldBullPrice) and not isNone(low[1]) ? low < bullPrice and low[1] >= heldBullPrice and bar.isConfirmed : false

// Shift, then retracement, then reset: the retracement state lasts one bar.
var bearState = 0
var bullState = 0
bearNext = bearState == 2 ? 0 : bearState
if bearCond and bearNext == 0
    bearNext = 1
if bearRetCond and bearNext == 1
    bearNext = 2
bearTrigger = bearNext == 2
bearState = bearNext

bullNext = bullState == 2 ? 0 : bullState
if bullCond and bullNext == 0
    bullNext = 1
if bullRetCond and bullNext == 1
    bullNext = 2
bullTrigger = bullNext == 2
bullState = bullNext

// ---- Markers and candle colours -----------------------------------------------
bearShiftMark = bearShow and bearShiftShow and bearCond
bullShiftMark = bullShow and bullShiftShow and bullCond
bearRetMark = bearShow and bearRetShow and bearTrigger
bullRetMark = bullShow and bullRetShow and bullTrigger

if bearShiftMark
    signal("", color = #FAA1A4, at = "above", shape = "triangleDown")
if bullShiftMark
    signal("", color = #70CCBD, at = "below", shape = "triangleUp")
if bearRetMark
    signal("Ret", color = #FAA1A4, at = "above", shape = "label")
if bullRetMark
    signal("Ret", color = #70CCBD, at = "below", shape = "label")

// The retracement colour wins where both land on one bar.
shiftTint = bearShiftMark ? bearSignalColor : bullShiftMark ? bullSignalColor : none
retTint = bearRetMark ? bearSignalColor : bullRetMark ? bullSignalColor : none
barColor(isNone(retTint) ? shiftTint : retTint)

// ---- Boxes and levels -----------------------------------------------------------
// Each shift boxes the swing range and draws the broken level across to this
// bar. Objects carry their event's serial so the oldest event leaves whole.
var evBoxes: array<box> = []
var evBoxSerial: array<number> = []
var evLines: array<line> = []
var evLineSerial: array<number> = []
var evSerial = 0

isBearEvent = bearShow and bearCond
isBullEvent = bullShow and bullCond
if isBearEvent or isBullEvent
    evSerial += 1
    tone = isBearEvent ? negColor : posColor
    push(evBoxes, draw.box(t3, zz3, t1, zz1, fillColor = tone, opacity = (100 - clamp(boxTransp, 0, 100)) / 100))
    push(evBoxSerial, evSerial)
    showLevel = isBearEvent ? bearShiftShow : bullShiftShow
    if showLevel
        push(evLines, draw.line(t2, zz2, time, zz2, color = tone, width = 1, style = "dashed"))
        push(evLineSerial, evSerial)
    if size(evBoxes) > maxEvents
        oldest = element(evBoxSerial, 0)
        draw.delete(shift(evBoxes))
        shift(evBoxSerial)
        while size(evLineSerial) > 0 and element(evLineSerial, 0) == oldest
            draw.delete(shift(evLines))
            shift(evLineSerial)

// The retracement level, drawn back to the swing it was measured from.
var retLines: array<line> = []
isBearRet = bearShow and bearRetShow and bearTrigger
isBullRet = bullShow and bullRetShow and bullTrigger
if isBearRet or isBullRet
    retPrice = isBearRet ? bearPrice : bullPrice
    retAnchor = isBearRet ? bearAnchor : bullAnchor
    if not isNone(retPrice) and not isNone(retAnchor)
        push(retLines, draw.line(retAnchor, retPrice, time, retPrice, color = isBearRet ? negColor : posColor, width = 1, style = "dotted"))
        if size(retLines) > maxEvents
            draw.delete(shift(retLines))

// The zig zag itself, through every pivot held, drawn once on the newest bar.
if bar.isLast and zzShow and size(pivTime) >= 2
    draw.polyline(pivTime, pivPrice, color = zzLineColor, width = 2)

// ---- Screener table -------------------------------------------------------------
// The screener, run on this instrument. The "Only Bullish" switch gates the
// bearish branch and "Only Bearish" the bullish one, as the screener defines.
byRetracement = scrMethod == "Retracement to OTE / OB"
bearMethod = byRetracement ? bearTrigger and bearRetCond : bearCond
bullMethod = byRetracement ? bullTrigger and bullRetCond : bullCond
allowBull = scrDirection != "Bearish"
allowBear = scrDirection != "Bullish"
screenSignal = scrShowBull and bearMethod and allowBear ? -1 : scrShowBear and bullMethod and allowBull ? 1 : none

var sigTimes: array<number> = []
var sigPrices: array<number> = []
var sigSides: array<number> = []
if not isNone(screenSignal)
    push(sigTimes, time)
    push(sigPrices, orElse(roundToTick(close), close))
    push(sigSides, screenSignal)
    if size(sigTimes) > 100
        shift(sigTimes)
        shift(sigPrices)
        shift(sigSides)

// Grids pin to the four corners, so each position is drawn in its nearest
// corner: a top row at the top, a middle or bottom row at the bottom, a left
// column on the left, a centre or right column on the right.
gridBottomLeft = table("Screener, bottom left", 102, 3, position = "bottomLeft")
gridBottomRight = table("Screener, bottom right", 102, 3, position = "bottomRight")
gridTopLeft = table("Screener, top left", 102, 3, position = "topLeft")
gridTopRight = table("Screener, top right", 102, 3, position = "topRight")

// A price written with up to four decimals and no trailing zeros.
fn priceText(v) =>
    s = text(v, 4)
    trimming = str.contains(s, ".")
    while trimming
        if str.endsWith(s, "0")
            s = str.substring(s, 0, str.length(s) - 1)
        else
            trimming = false
    if str.endsWith(s, ".")
        s = str.substring(s, 0, str.length(s) - 1)
    s

fn header(g, r, c, caption) =>
    cell(g, r, c, caption, textColor = neutralColor, bgColor = withAlpha(neutralColor, 0.1), align = "center")
    true

atTop = tblPosition == "top-left" or tblPosition == "top-center" or tblPosition == "top-right"
atLeft = tblPosition == "top-left" or tblPosition == "middle-left" or tblPosition == "bottom-left"

if bar.isLast
    g = atTop ? (atLeft ? gridTopLeft : gridTopRight) : (atLeft ? gridBottomLeft : gridBottomRight)
    // An intraday series has bars less than a day apart, read over the newest ten steps.
    intraday = false
    for j = 0 to 9
        if not isNone(time[j + 1]) and time[j] - time[j + 1] > 0 and time[j] - time[j + 1] < 86400000
            intraday = true
    header(g, 0, 0, byRetracement ? "Retracement to OTE / OB" : "Market Structure Shift")
    header(g, 0, 1, "")
    header(g, 0, 2, "")
    header(g, 1, 0, "Time")
    header(g, 1, 1, "Price")
    header(g, 1, 2, "Signal")
    shown = min(size(sigTimes), max(0, floor(tblRows)))
    if shown > 0
        for r = 0 to shown - 1
            at = size(sigTimes) - 1 - r
            side = element(sigSides, at)
            stamp = element(sigTimes, at)
            ink = side == 1 ? posColor : negColor
            when = intraday ? date.format(stamp, "HH:mm") + "  " + date.format(stamp, "dd-MM-yyyy") : date.format(stamp, "dd-MM-yyyy")
            cell(g, r + 2, 0, when, textColor = ink, bgColor = withAlpha(ink, 0.1), align = "left")
            cell(g, r + 2, 1, priceText(element(sigPrices, at)), textColor = ink, bgColor = withAlpha(ink, 0.1), align = "left")
            cell(g, r + 2, 2, side == 1 ? "Bullish" : "Bearish", textColor = ink, bgColor = withAlpha(ink, 0.1), align = "left")
