version 1
study("Futures Setups Research", overlay = true, precision = 2)

// A multi-timeframe setup engine for index futures. It collects Fair Value
// Gaps and Order Blocks from 5, 15, 30, 60 and 240 minute buckets folded from
// the chart's own bars, flips them into Inversion FVGs and Breaker Blocks when
// price closes through them, scores every active zone on structure, liquidity,
// market context and timeframe overlap, and turns the best qualifying touch
// into a drawn trade with a stop and 1R, 1.5R and 2R objectives. The engine is
// built for the 1-minute chart; on other charts it computes the regime panel
// only. A second-instrument divergence is not available to a single-symbol
// study, so the intermarket category can reach 4 of its 5 points.

// ---------------------------------------------------------------- settings

indicatorEnabled = input(true, "Enable indicator", group = "01 Quick Start")
allowUnsupportedSymbols = input(false, "Allow symbols other than NQ/ES", group = "01 Quick Start", tooltip = "The engine is tuned for NQ and ES futures. A symbol the chart never names is allowed through either way.")
allowNonOneMinuteCharts = input(false, "Allow chart timeframes above 1 minute", group = "01 Quick Start", tooltip = "The execution engine is optimized for the 1-minute chart. Higher chart timeframes are diagnostic only unless this option is enabled.")
sessionTimezone = input("America/New_York", "Session timezone", group = "01 Quick Start")
futuresSession = input("1800-1700:1234567", "Futures session", group = "01 Quick Start")
overnightSession = input("1800-0930:1234567", "Overnight session", group = "01 Quick Start")
rthSession = input("0930-1600:23456", "Regular trading hours", group = "01 Quick Start")
signalSession = input("0800-1600:23456", "Signal window", group = "01 Quick Start", tooltip = "Default covers the primary New York intraday window. Expand it when you intentionally want overnight or evening signals.")
