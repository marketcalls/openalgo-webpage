version 1
study("Average Directional Movement Index Rating (ADXR)", precision = 2)

period = input(14, "ADX Period", min = 1, max = 5000, step = 1, tooltip = "Number of bars used in the ADX calculation.")
ratingPeriod = input(14, "Rating Period", min = 1, max = 5000, step = 1, tooltip = "Number of bars between the current and the historical ADX.")

// True range, with the first bar's range as its own.
tr = bar.index > 0 ? max(high - low, max(abs(high - close[1]), abs(low - close[1]))) : high - low
// Directional movement needs a previous bar; the first bar has none.
upMove = high - high[1]
downMove = low[1] - low
plusDm = bar.index > 0 and upMove > downMove and upMove > 0 ? upMove : 0
minusDm = bar.index > 0 and downMove > upMove and downMove > 0 ? downMove : 0

// Wilder smoothing, each seeded with its first value. The running values are
// divided by 1 - e, where e = (1 - 1 / period) to the power of the bar index,
// to undo the bias of the seeding while e is still meaningful.
var e = 1.0
var trRaw = none
var pdmRaw = none
var mdmRaw = none
var adxRaw = none
trRaw = isNone(trRaw) ? tr : (trRaw * (period - 1) + tr) / period
pdmRaw = isNone(pdmRaw) ? plusDm : (pdmRaw * (period - 1) + plusDm) / period
mdmRaw = isNone(mdmRaw) ? minusDm : (mdmRaw * (period - 1) + minusDm) / period
dxSeeded = not isNone(adxRaw)

compensate = e > 1e-10
denominator = 1 - e
// On the first bar e is still 1, so the compensated values are absent.
usable = not compensate or denominator != 0
scale = compensate ? (denominator != 0 ? 1 / denominator : none) : 1
trSmooth = usable ? trRaw * scale : none
pdmSmooth = usable ? pdmRaw * scale : none
mdmSmooth = usable ? mdmRaw * scale : none

// Each directional index is capped at 50 before the ratio is taken.
ready = not isNone(trSmooth) and not isNone(pdmSmooth) and not isNone(mdmSmooth)
plusDi = ready ? (trSmooth != 0 ? min(100 * pdmSmooth / trSmooth, 50) : 0) : none
minusDi = ready ? (trSmooth != 0 ? min(100 * mdmSmooth / trSmooth, 50) : 0) : none
diSum = plusDi + minusDi
dx = ready ? (diSum != 0 ? 100 * abs(plusDi - minusDi) / diSum : 0) : none

// The ADX accumulator starts at zero, which the 1 - e divisor corrects.
if not dxSeeded
    adxRaw = 0
else if not isNone(dx)
    adxRaw = (adxRaw * (period - 1) + dx) / period

adxValue = usable and not isNone(adxRaw) ? adxRaw * scale : none

// The rating averages this ADX with the ADX `ratingPeriod` bars back. Before
// that many bars exist it reaches the first bar, whose ADX is absent and reads
// as zero.
back = min(ratingPeriod, bar.index)
historical = orElse(adxValue[back], 0)
adxr = isNone(adxValue) ? none : (adxValue + historical) / 2

e = e * (1 - 1 / period)

plot(adxr, "ADXR", #ffeb3b, width = 2)
plot(adxValue, "ADX", #ffeb3b, width = 2)
plot(plusDi, "+DI", #ffeb3b, width = 2)
plot(minusDi, "-DI", #ffeb3b, width = 2)
