version 1
study("Choppiness Index", precision = 2)

length = input(14, "Length", min = 2, max = 5000, step = 1)

// True range, with the bar's own close standing in for an absent previous close.
prevClose = orElse(close[1], close)
tr = max(high - low, max(abs(high - prevClose), abs(low - prevClose)))

// The window holds the last `length` bars, or every bar so far while fewer
// exist. The true range total is carried as a running sum.
win = min(bar.index + 1, length)
var sumTr = 0.0
sumTr = sumTr - (bar.index >= length ? tr[length] : 0) + tr

hhv = high
llv = low
for k = 1 to win - 1
    hhv = max(hhv, high[k])
    llv = min(llv, low[k])

// The sum of true ranges against the window's whole range, on a log scale
// normalised by the window length and held between 0 and 100.
priceRange = hhv - llv
chopValue = win >= 2 and priceRange > 0 ? clamp(100 * log10(sumTr / priceRange) / log10(win), 0, 100) : none

plot(chopValue, "CHOP", #ffeb3b, width = 2)
level(61.8, "High Threshold", #ef5350, style = "dashed")
level(38.2, "Low Threshold", #26a69a, style = "dashed")
level(50, "Midline", #787b86, style = "dashed")
