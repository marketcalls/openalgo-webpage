version 1
study("Weighted Close (HLCC4)", overlay = true, precision = 2)

// High and low plus the close counted twice, over four, so the bar's price
// leans towards where it settled.
weighted = (high + low + close + close) * 0.25

plot(weighted, "HLCC4", #ffeb3b, width = 2)
