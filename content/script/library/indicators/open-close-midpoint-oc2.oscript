version 1
study("Open-Close Midpoint (OC2)", overlay = true, precision = 2)

// The centre of the bar's body: half the sum of its open and its close.
bodyMid = (open + close) * 0.5

plot(bodyMid, "OC2", #ffeb3b, width = 2)
