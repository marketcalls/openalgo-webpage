version 1
study("Relative Strength Index (RSI)", precision = 2)

length = input(14, "Length", min = 1, max = 5000, step = 1)
source = input(close, "Source")

weight = 1 / length

// This bar's up move and down move. The first bar has no previous value, so it
// has no move at all.
change1 = source - source[1]
up = isNone(change1) ? none : max(change1, 0)
down = isNone(change1) ? none : max(-change1, 0)

// For the first length bars each average simply holds that bar's own move.
// From then on it is a running average with weight 1 / length, reading a
// missing previous average as zero.
var smoothUp = none
var smoothDown = none
if bar.index < length
    smoothUp = up
    smoothDown = down
else
    smoothUp = isNone(up) ? none : orElse(smoothUp, 0) * (1 - weight) + up * weight
    smoothDown = isNone(down) ? none : orElse(smoothDown, 0) * (1 - weight) + down * weight

// With no down move in the window the reading is a full 100.
rsiValue = isNone(smoothUp) or isNone(smoothDown) ? none : smoothDown == 0 ? 100 : 100 - 100 / (1 + smoothUp / smoothDown)

plot(rsiValue, "RSI", #ffeb3b, width = 2)
