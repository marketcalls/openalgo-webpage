version 1
study("Ichimoku Cloud", "Ichimoku", overlay = true, precision = 2)

conversionPeriods = input(9, "Conversion Line Length", min = 1)
basePeriods = input(26, "Base Line Length", min = 1)
laggingSpan2Periods = input(52, "Leading Span B Length", min = 1)
// A plot offset is fixed before the first bar and takes a setting only as its
// whole value, so the two directions are two settings. 25 and -25 are a
// displacement of 26: the cloud starts on the 26th bar ahead and the lagging
// span on the 26th bar back, counting the current bar as the first.
cloudOffset = input(25, "Cloud Offset", min = 0, max = 500, tooltip = "Bars ahead the leading spans and the cloud are drawn.")
laggingOffset = input(-25, "Lagging Span Offset", min = -500, max = 0, tooltip = "Bars back the closing price is drawn, as a negative number.")

// Each line is the midpoint of a range: the average of the lowest low and the
// highest high over its length, which is the middle element of donchian().
conversionLine = donchian(conversionPeriods)[1]
baseLine = donchian(basePeriods)[1]
leadLine1 = (conversionLine + baseLine) / 2
leadLine2 = donchian(laggingSpan2Periods)[1]

plot(conversionLine, "Conversion Line", #2962FF)
plot(baseLine, "Base Line", #B71C1C)
plot(close, "Lagging Span", #43A047, offset = laggingOffset)
p1 = plot(leadLine1, "Leading Span A", #A5D6A7, offset = cloudOffset)
p2 = plot(leadLine2, "Leading Span B", #EF9A9A, offset = cloudOffset)

// Green where Leading Span A is above B, red where it is below.
fill(p1, p2, leadLine1 > leadLine2 ? rgba(67, 160, 71, 0.1) : rgba(244, 67, 54, 0.1))
