version 1
study("Awesome Oscillator (AO)", precision = 2)

fastLength = input(5, "Fast Length", min = 1, max = 5000, step = 1)
slowLength = input(34, "Slow Length", min = 1, max = 5000, step = 1)

// The slow window is always at least one bar longer than the fast one.
slowLen = max(fastLength + 1, slowLength)

// The mean of the values seen so far, up to len of them, so the line starts
// on the first bar instead of after a warmup gap.
fn runningMean(x, len) =>
    var s = 0.0
    if bar.index >= len
        s = s - x[len]
    s = s + x
    s / min(bar.index + 1, len)

midpoint = (high + low) / 2
fastMa = runningMean(midpoint, fastLength)
slowMa = runningMean(midpoint, slowLen)
ao = fastMa - slowMa

// Green while the oscillator is not falling, red otherwise.
plot(ao, "AO", ao >= ao[1] ? #4caf50 : #ff5252, width = 2)
