version 1
study("Leader EMA (LEMA)", overlay = true, precision = 2)

source = input(close, "Source")
period = input(14, "Period", min = 1, max = 5000, step = 1)

weight = 2 / (period + 1)
keep = 1 - weight

// An absent source reads as zero.
price = orElse(source, 0)

// Two exponential stages that start from zero, each divided by (1 - decay)
// while the decay is still large, which removes the bias of starting at zero
// and lets the line answer from the first bar.
var ema1 = 0.0
var decay1 = 1.0
var warmup1 = true
var ema2 = 0.0
var decay2 = 1.0
var warmup2 = true

ema1 = weight * (price - ema1) + ema1
compEma1 = ema1
if warmup1
    decay1 = decay1 * keep
    compEma1 = ema1 / (1 - decay1)
    warmup1 = decay1 > 1e-10

// The second stage smooths the tracking error of the first.
trackingError = price - compEma1
ema2 = weight * (trackingError - ema2) + ema2
compEma2 = ema2
if warmup2
    decay2 = decay2 * keep
    compEma2 = ema2 / (1 - decay2)
    warmup2 = decay2 > 1e-10

// The average plus its smoothed error leans ahead of a plain average.
lema = compEma1 + compEma2

plot(lema, "LEMA", #ffeb3b, width = 2)
