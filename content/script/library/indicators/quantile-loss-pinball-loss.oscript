version 1
study("Quantile Loss (Pinball Loss)", precision = 4)

length = input(14, "Length", min = 1, max = 5000, step = 1)
quantile = input(0.5, "Quantile", min = 0.01, max = 0.99, step = 0.05, tooltip = "0.5 is the median (mean absolute error). Above 0.5 penalises under-prediction, below 0.5 penalises over-prediction.")
actual = input(close, "Actual")
predicted = input(open, "Predicted")

// An absent value on either side counts as zero.
a = orElse(actual, 0)
p = orElse(predicted, 0)

// A miss where the actual is above the prediction costs quantile per point;
// a miss below it costs (1 - quantile) per point.
diff = a - p
loss = diff >= 0 ? quantile * diff : (quantile - 1) * diff

plot(sma(loss, length), "Quantile Loss", #ffeb3b, width = 2)
level(0, "Zero", #787b86, style = "dashed")
