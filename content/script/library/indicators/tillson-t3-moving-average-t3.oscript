version 1
study("Tillson T3 Moving Average (T3)", overlay = true, precision = 2)

source = input(close, "Source")
period = input(10, "Period", min = 1, max = 5000, step = 1)
vfactor = input(0.7, "Volume Factor", min = 0, max = 1, step = 0.1)

a = 2 / (period + 1)
v = max(0, min(1, vfactor))
v2 = v * v
v3 = v2 * v
c1 = -v3
c2 = 3 * (v2 + v3)
c3 = -3 * (2 * v2 + v + v3)
c4 = 1 + 3 * v + 3 * v2 + v3

// Six chained exponential stages, all seeded with the first source value.
var seeded = false
var e1 = 0.0
var e2 = 0.0
var e3 = 0.0
var e4 = 0.0
var e5 = 0.0
var e6 = 0.0

t3Value = none
if not isNone(source)
    if not seeded
        e1 = source
        e2 = source
        e3 = source
        e4 = source
        e5 = source
        e6 = source
        seeded = true
        t3Value = source
    else
        e1 = e1 + a * (source - e1)
        e2 = e2 + a * (e1 - e2)
        e3 = e3 + a * (e2 - e3)
        e4 = e4 + a * (e3 - e4)
        e5 = e5 + a * (e4 - e5)
        e6 = e6 + a * (e5 - e6)
        // The volume factor sets how the last four stages are blended.
        t3Value = c1 * e6 + c2 * e5 + c3 * e4 + c4 * e3

plot(t3Value, "T3", #ffeb3b, width = 2)
