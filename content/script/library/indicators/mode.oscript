version 1
study("Mode", precision = 2)

source = input(close, "Source")
length = input(14, "Period", min = 1, max = 5000, step = 1)

// Early bars use as many bars as exist rather than waiting for a full window.
lookback = min(length, bar.index + 1)

// Count each distinct value, walking back from this bar. The values are kept
// in the order they were first met, which decides the winner of a tie.
values = []
counts = []
for j = 0 to lookback - 1
    v = source[j]
    if not isNone(v)
        idx = indexOf(values, v)
        if idx < 0
            push(values, v)
            push(counts, 1)
        else
            set(counts, idx, element(counts, idx) + 1)

// The first value with the highest count wins; a later value must beat it
// outright to take its place.
modeVal = none
maxFreq = 0
for i = 0 to size(values) - 1
    if element(counts, i) > maxFreq
        maxFreq = element(counts, i)
        modeVal = element(values, i)

// When every value in the window is different there is no mode at all.
if maxFreq <= 1 and size(values) > 1
    modeVal = none

plot(modeVal, "Mode", #ffeb3b, width = 2)
