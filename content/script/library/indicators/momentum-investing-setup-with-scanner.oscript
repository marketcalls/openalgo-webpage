version 1
study("Momentum Investing Setup with Scanner", overlay = true, precision = 2)

// A five-filter momentum screen. The 250-bar percentage change, RSI, MFI, CCI
// and volume against a multiple of its own average all have to agree before a
// bar is flagged. Supertrend rides the price, and the three oscillators are
// redrawn as small curves in price space under the candles, with a volume
// histogram above them, over the most recent bars.

pchgPct = input(8, "Above/Below %", min = 0, max = 1000, step = 0.1, group = "250 Candle % Change", tooltip = "Percentage change between the bar 250 back and this one. Positive for the long filter, its negative for the short filter. 8 suits the daily timeframe; try 2 to 4 intraday.")

rsiDisplay = input(true, "RSI Display", group = "Relative Strength Index (RSI)")
rsiLen = input(14, "RSI Length", min = 1, max = 500, step = 1, group = "Relative Strength Index (RSI)")
rsiSmaLen = input(14, "RSI SMA Length", min = 1, max = 500, step = 1, group = "Relative Strength Index (RSI)")
rsiOb = input(60, "RSI Overbought", min = 0, max = 100, step = 1, group = "Relative Strength Index (RSI)")
rsiOs = input(40, "RSI Oversold", min = 0, max = 100, step = 1, group = "Relative Strength Index (RSI)")
rsiVoffset = input(1.3, "RSI Vertical Offset", min = -10, max = 10, step = 0.1, group = "Relative Strength Index (RSI)")
rsiHeight = input(2, "RSI Height", min = 0.1, max = 20, step = 0.1, group = "Relative Strength Index (RSI)")

mfiDisplay = input(true, "MFI Display", group = "Money Flow Index (MFI)")
mfiLen = input(14, "MFI Length", min = 1, max = 500, step = 1, group = "Money Flow Index (MFI)")
mfiOb = input(60, "MFI Overbought", min = 0, max = 100, step = 1, group = "Money Flow Index (MFI)")
mfiOs = input(40, "MFI Oversold", min = 0, max = 100, step = 1, group = "Money Flow Index (MFI)")
mfiVoffset = input(1.6, "MFI Vertical Offset", min = -10, max = 10, step = 0.1, group = "Money Flow Index (MFI)")
mfiHeight = input(1, "MFI Height", min = 0.1, max = 20, step = 0.1, group = "Money Flow Index (MFI)")

cciDisplay = input(true, "CCI Display", group = "Commodity Channel Index (CCI)")
cciLen = input(20, "CCI Length", min = 1, max = 500, step = 1, group = "Commodity Channel Index (CCI)")
cciSmaLen = input(5, "CCI SMA Length", min = 1, max = 500, step = 1, group = "Commodity Channel Index (CCI)")
cciOb = input(100, "CCI Overbought", min = 0, max = 500, step = 1, group = "Commodity Channel Index (CCI)")
cciOs = input(-100, "CCI Oversold", min = -500, max = 0, step = 1, group = "Commodity Channel Index (CCI)")
cciVoffset = input(1.8, "CCI Vertical Offset", min = -10, max = 10, step = 0.1, group = "Commodity Channel Index (CCI)")
cciHeight = input(0.2, "CCI Height", min = 0.1, max = 20, step = 0.1, group = "Commodity Channel Index (CCI)")

volDisplay = input(true, "Display MA Line", group = "Volume")
volType = input("Regular Volume", "Type", options = ["Buying/Selling Volume", "Regular Volume", "None"], group = "Volume")
volMaLen = input(20, "MA Length", min = 1, max = 500, step = 1, group = "Volume")
volMaMulti = input(5, "MA Multiplier (x)", min = 1, max = 100, step = 0.1, group = "Volume", tooltip = "Lifts the volume moving average the signal has to clear. 1 applies no multiplier; the strategy asks for 5.")
volVoffset = input(0.3, "Volume Vertical Offset", min = -10, max = 10, step = 0.1, group = "Volume")
volHeight = input(0.6, "Volume Height", min = 0.1, max = 20, step = 0.1, group = "Volume")

stDisplay = input(true, "Supertrend Display", group = "Supertrend")
stAtrPeriod = input(10, "ATR Length", min = 1, max = 500, step = 1, group = "Supertrend")
stFactor = input(3, "Factor", min = 0.01, max = 50, step = 0.01, group = "Supertrend")

displayLen = input(50, "Display Length", min = 1, max = 500, step = 1, group = "Chart Settings", tooltip = "How many recent bars the overlay curves, the volume histogram and the signal shading cover.")

tablePosition = input("top-right", "Position", options = ["top-left", "top-center", "top-right", "middle-left", "middle-center", "middle-right", "bottom-left", "bottom-center", "bottom-right"], group = "Table")
tableSize = input("normal", "Size", options = ["tiny", "small", "normal", "large", "huge"], group = "Table")

POS = #26A69A
POS_LIGHT = #B2DFDB
NEG_LIGHT = #FFCDD2
NEG = #FF5250
INDICATOR = #2962FF
SIGNAL_COLOR = #FF6D00
NEUTRAL = #787B86

// ---------------------------------------------------------------------------
// The five filters
// ---------------------------------------------------------------------------

// 1. Percentage change over 250 bars, divided by the current close.
pchg = close != 0 ? (close - close[250]) / close * 100 : none

// 2. RSI of the close and its simple average.
rsiVal = rsi(close, rsiLen)
rsiSmaVal = sma(rsiVal, rsiSmaLen)

// 3. Money flow on the typical price. A bar whose typical price did not fall
// counts into the positive flow, and one that did not rise into the negative
// flow, so the first bar, with no change to test, counts into both.
fn slidingSum(values: series number, len: number) =>
    // A running window total. A bar with no value blanks the next len results
    // and no more.
    var total = 0
    var missing = 0
    if isNone(values)
        missing = missing + 1
    else
        total = total + values
    if bar.index >= len
        old = values[len]
        if isNone(old)
            missing = missing - 1
        else
            total = total - old
    bar.index >= len - 1 and missing == 0 ? total : none

typical = hlc3
typicalMove = typical - typical[1]
upFlow = isNone(volume) ? none : volume * (not isNone(typicalMove) and typicalMove <= 0 ? 0 : typical)
downFlow = isNone(volume) ? none : volume * (not isNone(typicalMove) and typicalMove >= 0 ? 0 : typical)
upSum = slidingSum(upFlow, mfiLen)
downSum = slidingSum(downFlow, mfiLen)
// A window with no volume at all has no reading.
mfiVal = isNone(upSum) or isNone(downSum) ? none : upSum == 0 and downSum == 0 ? none : downSum == 0 ? 100 : upSum == 0 ? 0 : 100 - 100 / (1 + upSum / downSum)

// 4. CCI of the typical price and its simple average.
cciVal = cci(cciLen)
cciSmaVal = sma(cciVal, cciSmaLen)

// 5. The volume threshold: an exponential average seeded with the simple
// average of its first values, lifted by the multiplier.
volEma = ema(volume, volMaLen)
volSmaVal = volEma * volMaMulti

// ---------------------------------------------------------------------------
// Supertrend, split into an up half and a down half so each keeps its colour
// and the line breaks at a flip. The first bar is left blank.
// ---------------------------------------------------------------------------

// The bands start on the first bar the average true range has a value. Each
// band only tightens unless the previous close broke through it. While the
// line rides the upper band it flips up on a close above that band; while it
// rides the lower band it stays up on a close at or above it.
stAtr = atr(stAtrPeriod)
var stPrevUpper = none
var stPrevLower = none
var stPrevLine = none
var stPrevClose = none
var stStarted = false
stLine = none
stDir = none
if not isNone(stAtr)
    stMid = (high + low) / 2
    upperBasic = stMid + stFactor * stAtr
    lowerBasic = stMid - stFactor * stAtr
    upperBand = stStarted ? (upperBasic < stPrevUpper or stPrevClose > stPrevUpper ? upperBasic : stPrevUpper) : upperBasic
    lowerBand = stStarted ? (lowerBasic > stPrevLower or stPrevClose < stPrevLower ? lowerBasic : stPrevLower) : lowerBasic
    if stStarted and stPrevLine != stPrevUpper
        stLine = close >= lowerBand ? lowerBand : upperBand
        stDir = close >= lowerBand ? -1 : 1
    else
        stLine = close <= upperBand ? upperBand : lowerBand
        stDir = close <= upperBand ? 1 : -1
    stPrevUpper = upperBand
    stPrevLower = lowerBand
    stPrevLine = stLine
    stPrevClose = close
    stStarted = true
stShown = stDisplay and not bar.isFirst and not isNone(stLine)
stIsUp = not isNone(stDir) and stDir < 0
plot(stShown and stIsUp ? stLine : none, "Supertrend Up", #26A69A, width = 2)
plot(stShown and not stIsUp ? stLine : none, "Supertrend Down", #FF5250, width = 2)

// Buying and selling volume, split by where the close sits in the bar. A bar
// with no range has no split.
barRange = high - low
nzVolume = orElse(volume, 0)
buyVol = barRange != 0 ? nzVolume * (close - low) / barRange : none
sellVol = barRange != 0 ? nzVolume * (high - close) / barRange : none

// ---------------------------------------------------------------------------
// Signals: every filter has to agree, on a settled bar.
// ---------------------------------------------------------------------------

ready = not isNone(pchg) and not isNone(rsiVal) and not isNone(mfiVal) and not isNone(cciVal) and not isNone(volume) and not isNone(volSmaVal)
volumeOk = ready and bar.isConfirmed and volume > volSmaVal
isShort = volumeOk and pchg < -pchgPct and rsiVal < rsiOs and mfiVal < mfiOs and cciVal < cciOs
isLong = volumeOk and not isShort and pchg > pchgPct and rsiVal > rsiOb and mfiVal > mfiOb and cciVal > cciOb

signal(isShort ? "Short" : none, color = #FFCDD2, at = "above", shape = "triangleDown")
signal(isLong ? "Long" : none, color = #B2DFDB, at = "below", shape = "triangleUp")

barColor(isShort ? NEG_LIGHT : isLong ? POS_LIGHT : none)

// The shading covers only the most recent Display Length bars. A bar is in
// that window when fewer than Display Length bar intervals separate it from
// the chart's current time.
intervalMs = orElse(chart.intervalMinutes, 0) * 60000
barsBack = intervalMs > 0 ? floor((chart.now() - time) / intervalMs) : 0
recent = barsBack < displayLen
background(recent and isShort ? withAlpha(NEG_LIGHT, 0.1) : recent and isLong ? withAlpha(POS_LIGHT, 0.1) : none)

// ---------------------------------------------------------------------------
// The overlay drawings, rebuilt on the newest bar
// ---------------------------------------------------------------------------

// An oscillator level mapped into price space below the candles.
fn oscPrice(voffset, height, lvl, priceLow, rate) =>
    isNone(lvl) ? none : priceLow * (1 - rate * voffset) * (1 + (lvl / 100) * rate * height)

// One path per unbroken run of prices: a missing price breaks the line, and a
// run of a single point draws nothing.
fn drawPath(times: array<number>, prices: array<number>, col) =>
    runStart = 0
    n = size(prices)
    for i = 0 to n
        gap = i == n ? true : isNone(element(prices, i))
        if gap
            if i - runStart > 1
                draw.polyline(slice(times, runStart, i), slice(prices, runStart, i), color = col, width = 1)
            runStart = i + 1
    n

// A reference level across the window, at a quarter strength.
fn drawRef(t0, t1, price, col) =>
    if not isNone(price)
        draw.line(t0, price, t1, price, color = withAlpha(col, 0.25), width = 1)
    price

// The reading beside the newest bar, with no plate.
fn drawTag(t, price, caption, col) =>
    if not isNone(price)
        draw.label(t, price, caption, color = none, textColor = col, align = "left")
    price

fn fmt(v) => isNone(v) ? "-" : text(v, 2)

fn compactVolume(v) =>
    a = abs(v)
    a >= 1000000000 ? text(v / 1000000000, 2) + "B" : a >= 1000000 ? text(v / 1000000, 2) + "M" : a >= 1000 ? text(v / 1000, 2) + "K" : text(round(v), 0)

if bar.isLast
    draw.deleteAll()
    // Two windows: the lines and paths span Display Length + 1 bars, and the
    // extremes and the histogram span Display Length bars.
    kStart = min(displayLen, bar.index)
    kStat = min(displayLen - 1, bar.index)

    priceHighest = high
    priceLowest = low
    volumeHighest = 0
    for k = 0 to kStat
        if high[k] > priceHighest
            priceHighest = high[k]
        if low[k] < priceLowest
            priceLowest = low[k]
        v = orElse(volume[k], 0)
        if v > volumeHighest
            volumeHighest = v
    rate = priceHighest != 0 ? (priceHighest - priceLowest) / priceHighest : 0
    startTime = time[kStart]

    times = []
    mfiPath = []
    rsiPath = []
    rsiSmaPath = []
    cciPath = []
    cciSmaPath = []
    for k = kStart to 0 step -1
        push(times, time[k])
        push(mfiPath, oscPrice(mfiVoffset, mfiHeight, mfiVal[k], priceLowest, rate))
        push(rsiPath, oscPrice(rsiVoffset, rsiHeight, rsiVal[k], priceLowest, rate))
        push(rsiSmaPath, oscPrice(rsiVoffset, rsiHeight, rsiSmaVal[k], priceLowest, rate))
        push(cciPath, oscPrice(cciVoffset, cciHeight, cciVal[k], priceLowest, rate))
        push(cciSmaPath, oscPrice(cciVoffset, cciHeight, cciSmaVal[k], priceLowest, rate))

    if mfiDisplay
        drawRef(startTime, time, oscPrice(mfiVoffset, mfiHeight, mfiOb, priceLowest, rate), POS)
        drawRef(startTime, time, oscPrice(mfiVoffset, mfiHeight, 50, priceLowest, rate), NEUTRAL)
        drawRef(startTime, time, oscPrice(mfiVoffset, mfiHeight, mfiOs, priceLowest, rate), NEG)
        drawPath(times, mfiPath, INDICATOR)
        drawTag(time, oscPrice(mfiVoffset, mfiHeight, 50, priceLowest, rate), "MFI " + fmt(mfiVal), INDICATOR)

    if rsiDisplay
        drawRef(startTime, time, oscPrice(rsiVoffset, rsiHeight, rsiOb, priceLowest, rate), POS)
        drawRef(startTime, time, oscPrice(rsiVoffset, rsiHeight, 50, priceLowest, rate), NEUTRAL)
        drawRef(startTime, time, oscPrice(rsiVoffset, rsiHeight, rsiOs, priceLowest, rate), NEG)
        drawPath(times, rsiPath, INDICATOR)
        drawPath(times, rsiSmaPath, SIGNAL_COLOR)
        drawTag(time, oscPrice(rsiVoffset, rsiHeight, 50, priceLowest, rate), "RSI " + fmt(rsiVal), INDICATOR)

    if cciDisplay
        // The CCI's middle line is its zero level.
        drawRef(startTime, time, oscPrice(cciVoffset, cciHeight, cciOb, priceLowest, rate), POS)
        drawRef(startTime, time, oscPrice(cciVoffset, cciHeight, 0, priceLowest, rate), NEUTRAL)
        drawRef(startTime, time, oscPrice(cciVoffset, cciHeight, cciOs, priceLowest, rate), NEG)
        drawPath(times, cciPath, INDICATOR)
        drawPath(times, cciSmaPath, SIGNAL_COLOR)
        drawTag(time, oscPrice(cciVoffset, cciHeight, 0, priceLowest, rate), "CCI " + fmt(cciVal), INDICATOR)

    // Volume sits above the candles.
    volBase = priceHighest * (1 + rate * volVoffset)

    if volType != "None"
        total = isNone(buyVol) or isNone(sellVol) ? none : buyVol + sellVol
        buyPct = not isNone(total) and total != 0 ? fmt(buyVol / total * 100) : "-"
        sellPct = not isNone(total) and total != 0 ? fmt(sellVol / total * 100) : "-"
        avgText = isNone(volSmaVal) ? "-" : compactVolume(volSmaVal)
        drawTag(time, volBase, "VOL  Buy " + buyPct + "%  Sell " + sellPct + "%\nLast " + compactVolume(nzVolume) + "  Avg " + avgText, NEUTRAL)

    // The histogram is drawn only when the newest bar carries volume.
    if volType != "None" and nzVolume != 0
        buySell = volType == "Buying/Selling Volume"
        for k = kStat to 0 step -1
            v = orElse(volume[k], 0)
            top = volumeHighest > 0 ? volBase * (1 + (v / volumeHighest) * rate * volHeight) : none
            if not isNone(top)
                draw.line(time[k], volBase, time[k], top, color = buySell ? POS : close[k] > open[k] ? POS : NEG, width = 2)
                if buySell
                    sv = sellVol[k]
                    sellTop = isNone(sv) or volumeHighest <= 0 ? none : volBase * (1 + (sv / volumeHighest) * rate * volHeight)
                    if not isNone(sellTop)
                        draw.line(time[k], volBase, time[k], sellTop, color = NEG, width = 2)

        // The volume threshold (the average times the multiplier), drawn
        // through the histogram: each bar's height divided by its volume over
        // the threshold. A bar with no volume breaks the line.
        if volDisplay
            maPath = []
            for k = kStart to 0 step -1
                v = orElse(volume[k], 0)
                maVal = volSmaVal[k]
                volRate = not isNone(maVal) and maVal != 0 ? v / maVal : none
                push(maPath, not isNone(volRate) and volRate != 0 and volumeHighest > 0 ? volBase * (1 + ((v / volumeHighest) * rate * volHeight) / volRate) : none)
            drawPath(times, maPath, NEUTRAL)

// ---------------------------------------------------------------------------
// The readout: each filter's reading, coloured by its verdict
// ---------------------------------------------------------------------------

// The grid sits in the corner nearest the chosen position.
gridTopRight = table("Momentum readout", 5, 2, position = "topRight", borderWidth = 2)
gridTopLeft = table("Momentum readout, top left", 5, 2, position = "topLeft", borderWidth = 2)
gridBottomLeft = table("Momentum readout, bottom left", 5, 2, position = "bottomLeft", borderWidth = 2)
gridBottomRight = table("Momentum readout, bottom right", 5, 2, position = "bottomRight", borderWidth = 2)

fn verdict(v, ob, os) => isNone(v) ? NEUTRAL : v > ob ? POS : v < os ? NEG : NEUTRAL

fn readoutRow(grid, row, name, value, col) =>
    cell(grid, row, 0, name, textColor = col, bgColor = withAlpha(col, 0.1), align = "left")
    cell(grid, row, 1, value, textColor = col, bgColor = withAlpha(col, 0.1), align = "left")
    row

if bar.isLast
    corner = tablePosition == "top-left" or tablePosition == "middle-left" ? "topLeft" : tablePosition == "bottom-left" ? "bottomLeft" : tablePosition == "bottom-right" or tablePosition == "bottom-center" ? "bottomRight" : "topRight"
    grid = corner == "topLeft" ? gridTopLeft : corner == "bottomLeft" ? gridBottomLeft : corner == "bottomRight" ? gridBottomRight : gridTopRight
    colVol = not isNone(volume) and not isNone(volSmaVal) and volume > volSmaVal ? POS : NEUTRAL
    readoutRow(grid, 0, "%Chg", fmt(pchg), verdict(pchg, pchgPct, -pchgPct))
    readoutRow(grid, 1, "RSI", fmt(rsiVal), verdict(rsiVal, rsiOb, rsiOs))
    readoutRow(grid, 2, "MFI", fmt(mfiVal), verdict(mfiVal, mfiOb, mfiOs))
    readoutRow(grid, 3, "CCI", fmt(cciVal), verdict(cciVal, cciOb, cciOs))
    readoutRow(grid, 4, "Vol", (isNone(volume) ? "-" : fmt(volume / 100000)) + " L", colVol)
