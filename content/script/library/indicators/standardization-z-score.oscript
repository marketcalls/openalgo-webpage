version 1
study("Standardization (Z-score)", precision = 3)

source = input(close, "Source")
length = input(20, "Lookback Period", min = 2, max = 5000, step = 1, tooltip = "Period for mean and standard deviation. Must be at least 2 for stdev.")

// Running sum, sum of squares and count over a window of at most length
// bars. A bar with no value takes a slot in the window but adds nothing.
var s1 = 0.0
var s2 = 0.0
var filled = 0
if bar.index >= length
    old = source[length]
    if not isNone(old)
        s1 = s1 - old
        s2 = s2 - old * old
        filled = filled - 1
if not isNone(source)
    s1 = s1 + source
    s2 = s2 + source * source
    filled = filled + 1

// The sample standard deviation from the running sums. Fewer than two real
// values leaves it undefined, and a variance below 1e-10 counts as zero.
fn zOf(x, a1, a2, k) =>
    if k < 2 or isNone(x)
        return none
    m = a1 / k
    vp = a2 / k - m * m
    if not (vp >= 1e-10)
        vp = 0
    sd = sqrt(vp * k / (k - 1))
    if sd > 1e-10
        return (x - m) / sd
    // A dead-flat window: the value sits exactly on its own mean.
    abs(x - m) < 1e-10 ? 0 : none

z = zOf(source, s1, s2, filled)

plot(z, "Z-score", #ffeb3b, width = 2)
level(0, "Zero Line", #787b86, style = "dashed")
