version 1
study("Velocity (VEL)", precision = 4)

length = input(10, "Length", min = 1, max = 5000, step = 1)
source = input(close, "Source")

period = max(1, floor(length))

// Jurik smoothing constants. Phase is fixed at 100 and power at 0.2, so every
// one of them follows from the period alone.
phaseValue = min(max(100 * 0.01 + 1.5, 0.5), 2.5)
power = 0.2
betaK = (power * (period - 1)) / (power * (period - 1) + 2)
halfLen = sqrt(0.5 * (period - 1))
len1 = halfLen > 0 ? max(log(halfLen) / log(2) + 2, 0) : 0
pow1 = max(len1 - 2, 0.5)
len2 = halfLen * len1
pow1Reciprocal = 1 / pow1
avgVoltyAlpha = 2 / (max(4 * period, 65) + 1)
voltyDiv = 1 / (10 + (10 * min(max(period - 10, 0), 100)) / 100)
rvoltyCap = pow(len1, pow1Reciprocal)

// The change of the source over the lookback. Before the lookback exists the
// filter is fed a zero change rather than nothing.
diff = orElse(source - source[period], 0)

var upperBand = none
var lowerBand = none
var ma1 = none
var jma = none
var avgVolty = none
var vSum = 0.0
var det0 = 0.0
var det1 = 0.0

del1 = diff - (isNone(upperBand) ? diff : upperBand)
del2 = diff - (isNone(lowerBand) ? diff : lowerBand)
volty = abs(del1) == abs(del2) ? 0 : max(abs(del1), abs(del2))

// The volatility of ten bars ago, read as zero before there is one.
voltyBack = orElse(volty[10], 0)
vSum = vSum + (volty - voltyBack) * voltyDiv
avgVolty = isNone(avgVolty) ? vSum : avgVolty + avgVoltyAlpha * (vSum - avgVolty)

rvolty = avgVolty > 0 ? volty / avgVolty : 1
rvolty = min(max(rvolty, 1), rvoltyCap)

pow2 = pow(rvolty, pow1)
kv = pow(len2 / (len2 + 1), sqrt(pow2))

upperBand = del1 > 0 ? diff : diff - kv * del1
lowerBand = del2 < 0 ? diff : diff - kv * del2

alphaK = pow(betaK, pow2)
alphaSquared = alphaK * alphaK
oneMinusAlpha = 1 - alphaK
oneMinusAlphaSquared = oneMinusAlpha * oneMinusAlpha

ma1Prev = isNone(ma1) ? diff : ma1
ma1 = diff + alphaK * (ma1Prev - diff)
det0 = (diff - ma1) * (1 - betaK) + betaK * det0
ma2 = ma1 + phaseValue * det0

jmaPrev = isNone(jma) ? diff : jma
det1 = (ma2 - jmaPrev) * oneMinusAlphaSquared + alphaSquared * det1
jma = jmaPrev + det1

// The filter runs from the first bar, but the line starts once the lookback
// change exists.
plot(bar.index >= period ? jma : none, "VEL", #ffeb3b, width = 2)
