version 1
study("Rogers-Satchell Volatility (RSV)", precision = 4)

length = input(20, "Length", min = 1, max = 5000, step = 1, tooltip = "Lookback period for SMA smoothing of the Rogers-Satchell variance.")
annualize = input(true, "Annualize Volatility", tooltip = "Scale the output to an annual figure.")
annualPeriods = input(252, "Annual Periods", min = 1, max = 100000, step = 1, tooltip = "Number of periods in a year (252 for daily, 52 for weekly).")

// Every price is floored at a tiny positive number so the logarithms stay defined.
floorPrice = 0.0000001
h = max(orElse(high, 0), floorPrice)
l = max(orElse(low, 0), floorPrice)
o = max(orElse(open, 0), floorPrice)
c = max(orElse(close, 0), floorPrice)

// The bar's variance: log(high/open) x log(high/close) + log(low/open) x log(low/close).
barVariance = log(h / o) * log(h / c) + log(l / o) * log(l / c)

// A simple average of the variance over the window, then its square root,
// optionally scaled to a yearly figure.
smoothed = sma(barVariance, length)
scale = annualize ? sqrt(annualPeriods) : 1
rsv = sqrt(max(0, smoothed)) * scale

plot(rsv, "RSV", #ffeb3b, width = 2)
