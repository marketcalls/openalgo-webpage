version 1
study("Highest Value (HIGHEST)", overlay = true, precision = 2)

period = input(14, "Period", min = 1, max = 5000, step = 1)
source = input(close, "Source")

// A missing source value counts as zero and still enters the window.
value = orElse(source, 0)

// Until the window is full the line is the highest value seen so far, so it
// answers from the first bar. After that it is the highest of the last
// period bars.
var runningHigh = none
runningHigh = isNone(runningHigh) ? value : max(runningHigh, value)
windowHigh = highest(value, period)
result = bar.index < period - 1 ? runningHigh : windowHigh

plot(result, "Highest", #ffeb3b, width = 2)
