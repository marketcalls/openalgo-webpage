version 1
study("TRAMA: Trend Regularity Adaptive Moving Average", overlay = true, precision = 2)

period = input(14, "Period", min = 1, max = 5000, step = 1)

// A bar counts when the highest high of the window rises or the lowest low
// falls. During warmup, before either window is full, a bar does not count.
hhChange = change(highest(high, period))
llChange = change(lowest(low, period))
hh = isNone(hhChange) ? none : max(sign(hhChange), 0)
ll = isNone(llChange) ? none : max(sign(llChange * -1), 0)
fired = (not isNone(hh) and hh != 0) or (not isNone(ll) and ll != 0) ? 1 : 0

// The share of counting bars in the window, squared, is the smoothing factor.
regularity = sma(fired, period)

// The average moves toward the close by that factor. When the previous value
// is missing it restarts at the close.
var ama = none
prevAma = ama
prevNz = orElse(prevAma, 0)
next = none
if not isNone(regularity) and not isNone(close)
    tc = regularity * regularity
    next = prevNz + tc * (close - prevNz)
if isNone(prevAma)
    next = close
ama = next

plot(ama, "TRAMA", #ffeb3b, width = 2)
