version 1
study("Slope, Linear Regression (SLOPE)", precision = 4)

period = input(14, "Period", min = 2, max = 5000, step = 1)
source = input(close, "Source")

// Least squares slope through the last period bars, in price per bar. Each
// sample is placed at its position from the oldest bar in the window
// (0 for the oldest), and a missing sample is skipped but keeps its place.
filled = min(bar.index + 1, floor(period))
sumY = 0.0
sumJY = 0.0
sumJ = 0.0
sumJ2 = 0.0
valid = 0
j = 0
while j < filled
    y = source[filled - 1 - j]
    if not isNone(y)
        sumY = sumY + y
        sumJY = sumJY + j * y
        sumJ = sumJ + j
        sumJ2 = sumJ2 + j * j
        valid = valid + 1
    j = j + 1

divisor = valid * sumJ2 - sumJ * sumJ
fitted = valid < 2 or divisor == 0 ? none : (valid * sumJY - sumJ * sumY) / divisor

plot(fitted, "Slope", #ffeb3b, width = 2)
