version 1
study("MIDPRICE: Midpoint Price over Period", overlay = true, precision = 2)

period = input(14, "Period", min = 1, max = 5000, step = 1)

// The centre of the range traded over the window: the highest high and the
// lowest low of the last `period` bars, averaged. Absent until the window is
// full.
hiHigh = highest(high, period)
loLow = lowest(low, period)
midPrice = (hiHigh + loLow) * 0.5

plot(midPrice, "MidPrice", #9c27b0, width = 2)
