version 1
study("Liquidity Void Fill Scanner", overlay = true, precision = 2)

// ---- Signals --------------------------------------------------------------------
showLong = input(true, "Long Signals", group = "Signals")
showShort = input(true, "Short Signals", group = "Signals")

// ---- Liquidity void -------------------------------------------------------------
fibVal = input(0.5, "Fib Value", min = 0, max = 1, step = 0.1, group = "Liquidity Void", tooltip = "0 is the bottom of a bullish candle and the top of a bearish one. 1 is the opposite end. 0.5 is the midpoint. Other Fibonacci or OTE values such as 0.62, 0.705 and 0.79 are usable. Range 0 to 1.")

// ---- Additional filters ---------------------------------------------------------
atrFilter = input(true, "Apply ATR Filter", group = "Additional Filters", tooltip = "Applies to the displacement candle only. Keeps only candles whose range exceeds the ATR multiple, so a higher multiplier demands a longer candle.")
atrLength = input(14, "ATR Length", min = 1, max = 5000, step = 1, group = "Additional Filters")
atrMulti = input(1, "ATR Multiplier", min = 1, max = 100, step = 0.1, group = "Additional Filters")
bodyFilter = input(true, "Apply Body % Filter", group = "Additional Filters", tooltip = "Applies to the displacement candle only. At 80 the candle body must cover more than 80 percent of its total length.")
bodyPercent = input(80, "Body % Above", min = 0, max = 100, step = 1, group = "Additional Filters")
bodySizeFilter = input(false, "Apply Body Size Filter", group = "Additional Filters", tooltip = "Applies to the displacement candle only. At 2 the candle range must be at least twice the previous candle range.")
bodySizeMultiplier = input(2, "Body Size Multiplier (x)", min = 0, max = 100, step = 1, group = "Additional Filters")
timeFilter = input(false, "Apply Time Filter", group = "Additional Filters", tooltip = "Applies to the retracement candle only. Keeps signals inside the given exchange-clock window.")
hourFrom = input(9, "Time From (hour)", min = 0, max = 23, step = 1, group = "Additional Filters")
minuteFrom = input(15, "Time From (minute)", min = 0, max = 59, step = 1, group = "Additional Filters")
hourTo = input(10, "Time To (hour)", min = 0, max = 23, step = 1, group = "Additional Filters")
minuteTo = input(15, "Time To (minute)", min = 0, max = 59, step = 1, group = "Additional Filters")
dateFilter = input(false, "Apply Date Filter", group = "Additional Filters", tooltip = "Applies to the retracement candle only. Keeps signals on the given date only. Enter yesterday to review yesterday.")
day = input(13, "Day", min = 1, max = 31, step = 1, group = "Additional Filters")
month = input(3, "Month", min = 1, max = 12, step = 1, group = "Additional Filters")
year = input(2025, "Year", min = 0, max = 9999, step = 1, group = "Additional Filters")

// ---- Data table -----------------------------------------------------------------
showDataTable = input(true, "Display Table", group = "Data Table")

POS = #089981
POS_LIGHT = #ACE5DC
NEG_LIGHT = #FCCBCD
NEG = #F23645
NEU = #D1D4DC
NEU_DARK = #0F0F0F

// ---- Displacement candle filters ------------------------------------------------
// Each filter passes when it is switched off and only narrows when it is on.
barRange = high - low
bodyShare = barRange > 0 ? abs(close - open) / barRange : none
wideBody = not isNone(bodyShare) and bodyShare >= bodyPercent / 100

// The average true range is absent through its warmup, and the filter blocks
// rather than passes there.
atrV = atr(atrLength)
atrOk = not atrFilter or (not isNone(atrV) and barRange > atrV * atrMulti)
bodyOk = not bodyFilter or wideBody
prevRange = high[1] - low[1]
bodySizeOk = not bodySizeFilter or (wideBody and not isNone(prevRange) and barRange >= prevRange * bodySizeMultiplier)
filtersOk = atrOk and bodyOk and bodySizeOk

// A bearish or bullish displacement candle.
shortCont1 = open > close and filtersOk
longCont1 = open < close and filtersOk

// ---- The void levels ---------------------------------------------------------------
// The newest displacement candle of each side.
var shortHigh = none
var shortLow = none
var longHigh = none
var longLow = none

if shortCont1
    shortHigh = high
    shortLow = low
if longCont1
    longHigh = high
    longLow = low

// The bearish level is measured down from the candle's high, the bullish one up
// from the candle's low.
bearFib = isNone(shortHigh) ? none : shortHigh - (shortHigh - shortLow) * fibVal
bullFib = isNone(longLow) ? none : longLow + (longHigh - longLow) * fibVal

// ---- Retracement filters, on the chart's clock -----------------------------------
barHour = date.hour(time)
barMinute = date.minute(time)
timeOk = not timeFilter or ((barHour > hourFrom or (barHour == hourFrom and barMinute >= minuteFrom)) and (barHour < hourTo or (barHour == hourTo and barMinute < minuteTo)))
dateOk = not dateFilter or (date.year(time) == year and date.month(time) == month and date.day(time) == day)

// The high crosses up through the bearish level, the low crosses down through
// the bullish one, with both bars and both levels present.
crossedOverBear = not isNone(bearFib) and not isNone(bearFib[1]) and not isNone(high[1]) and high > bearFib and high[1] <= bearFib[1]
crossedUnderBull = not isNone(bullFib) and not isNone(bullFib[1]) and not isNone(low[1]) and low < bullFib and low[1] >= bullFib[1]

// Only a closed bar may signal, so a bar still forming never fires.
shortCont2 = crossedOverBear and timeOk and dateOk and bar.isConfirmed
longCont2 = crossedUnderBull and timeOk and dateOk and bar.isConfirmed

// Two steps: arm on the displacement candle, fire on the retracement, and
// clear on the bar after the signal.
var shortState = 0
var longState = 0

shortState = shortState == 2 ? 0 : shortState
if shortCont1 and shortState == 0
    shortState = 1
if not shortCont1 and shortCont2 and shortState == 1
    shortState = 2

longState = longState == 2 ? 0 : longState
if longCont1 and longState == 0
    longState = 1
if not longCont1 and longCont2 and longState == 1
    longState = 2

shortRet = shortState == 2
longRet = longState == 2

// ---- Fill levels ------------------------------------------------------------------
// The level of the newest displacement candle, drawn on every bar while its
// side is armed and on the bar that fills it. Whether a level will be filled
// is only known on the fill bar, and a plot writes only the bar it runs on, so
// the line also shows levels a newer candle replaced and levels never filled.
plot(showShort and shortState != 0 ? bearFib : none, "Short Fill Level", NEG, width = 2)
plot(showLong and longState != 0 ? bullFib : none, "Long Fill Level", POS, width = 2)

// ---- Markers and candle colours -------------------------------------------------------
signal(showShort and shortRet ? "Short" : none, color = #FCCBCD, at = "above", shape = "triangleDown")
signal(showLong and longRet ? "Long" : none, color = #ACE5DC, at = "below", shape = "triangleUp")

// The displacement candle itself is repainted, the bearish one first.
barColor(showShort and shortCont1 ? NEG_LIGHT : showLong and longCont1 ? POS_LIGHT : none)

// ---- Data table: the day's change and volume ----------------------------------------
// Both reset on the first bar of each calendar day; the first bar is not one.
isNewDay = bar.isFirst ? false : not date.isSameDay(time, time[1])
prevClose = close[1]
dailyPct = not isNone(prevClose) and prevClose != 0 ? (close - prevClose) / prevClose * 100 : 0

var cumPchg = none
cumPchg = isNewDay ? dailyPct : isNone(cumPchg) ? dailyPct : cumPchg + dailyPct

// The day's volume is unknown until the first new day begins, and the previous
// day's is unknown until the second.
var currCumVol = none
var prevCumVol = none
if isNewDay
    prevCumVol = currCumVol
    currCumVol = orElse(volume, 0)
else
    currCumVol = currCumVol + orElse(volume, 0)
volBase = isNone(prevCumVol) ? currCumVol : prevCumVol
cumVolPchg = not isNone(volBase) and volBase != 0 ? (currCumVol - volBase) / volBase * 100 : none

// At most two decimals, with trailing zeros dropped.
fn fmt2(v) =>
    s = text(v, 2)
    trimming = true
    while trimming
        if str.endsWith(s, "0")
            s = str.substring(s, 0, str.length(s) - 1)
        else
            trimming = false
    if str.endsWith(s, ".")
        s = str.substring(s, 0, str.length(s) - 1)
    s

fn pct(v) => (isNone(v) ? "na" : fmt2(v)) + " %"
fn lakhs(v) => isNone(v) ? "na" : fmt2(v / 100000) + " L"

dataTable = table("Day change and volume", 4, 2, position = "topRight")

if showDataTable and bar.isLast
    cell(dataTable, 0, 0, "%Chg", textColor = NEU, bgColor = NEU_DARK, align = "left")
    cell(dataTable, 0, 1, pct(cumPchg), textColor = NEU, bgColor = NEU_DARK, align = "right")
    cell(dataTable, 1, 0, "Vol %Chg", textColor = NEU, bgColor = NEU_DARK, align = "left")
    cell(dataTable, 1, 1, pct(cumVolPchg), textColor = NEU, bgColor = NEU_DARK, align = "right")
    cell(dataTable, 2, 0, "Vol", textColor = NEU, bgColor = NEU_DARK, align = "left")
    cell(dataTable, 2, 1, lakhs(currCumVol), textColor = NEU, bgColor = NEU_DARK, align = "right")
    cell(dataTable, 3, 0, "PD Vol", textColor = NEU, bgColor = NEU_DARK, align = "left")
    cell(dataTable, 3, 1, lakhs(prevCumVol), textColor = NEU, bgColor = NEU_DARK, align = "right")
