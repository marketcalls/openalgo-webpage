version 1
study("Parkinson Volatility (PV)", precision = 4)

length = input(20, "Length", min = 1, max = 5000, step = 1, tooltip = "Lookback period for RMA smoothing of High/Low squared log returns.")
annualize = input(true, "Annualize Volatility", tooltip = "Annualize the Parkinson Volatility output.")
annualPeriods = input(252, "Annual Periods", min = 1, max = 100000, step = 1, tooltip = "Number of periods in a year for annualization (e.g. 252 for daily, 52 for weekly).")

// The squared log of the bar's high over its low.
logRange = high != low ? orElse(log(high / low), 0) : 0.0
squared = logRange * logRange

// A running average with weight 1 / length, seeded with the simple average of
// the first length values (empty until then), then scaled by 1 / (4 ln 2).
smoothed = rma(squared, length)
scale = annualize ? sqrt(annualPeriods) : 1.0
pv = smoothed >= 0 ? sqrt(smoothed / (4.0 * log(2))) * scale : none

plot(pv, "PV", #ffeb3b, width = 2)
