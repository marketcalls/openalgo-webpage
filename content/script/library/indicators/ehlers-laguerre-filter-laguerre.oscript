version 1
study("Ehlers Laguerre Filter (LAGUERRE)", overlay = true, precision = 2)

gamma = input(0.8, "Gamma", min = 0, max = 0.99, step = 0.01, tooltip = "Damping factor. 0 behaves as an FIR filter, higher values smooth more and lag more.")
source = input(close, "Source")

g = min(0.99, max(0, gamma))
omg = 1 - g

// A missing price falls back to the previous bar's price.
s = orElse(source, source[1])

// Four Laguerre stages, all seeded with the first price.
var l0 = none
var l1 = none
var l2 = none
var l3 = none
if not isNone(s)
    if isNone(l0)
        l0 = s
        l1 = s
        l2 = s
        l3 = s
    else
        p0 = l0
        p1 = l1
        p2 = l2
        l0 = omg * s + g * p0
        l1 = -g * l0 + p0 + g * p1
        l2 = -g * l1 + p1 + g * p2
        l3 = -g * l2 + p2 + g * l3

laguerre = isNone(s) ? none : (l0 + 2 * l1 + 2 * l2 + l3) / 6
plot(laguerre, "Laguerre", #ffeb3b, width = 2)
