version 1
study("Intraday Momentum Index (IMI)", precision = 2)

period = input(14, "Period", min = 1, max = 5000, step = 1, tooltip = "Number of bars used in the calculation")

// Each bar's body counts as a gain when it closed above its open and as a
// loss when it closed below it.
gain = not isNone(open) and not isNone(close) and close > open ? close - open : 0
loss = not isNone(open) and not isNone(close) and close < open ? open - close : 0

// Running totals over the last period bars. Bars before the first count as
// zero, so the line starts on the first bar.
var gainSum = 0.0
var lossSum = 0.0
gainSum = gainSum + gain
lossSum = lossSum + loss
if bar.index >= period
    gainSum = gainSum - gain[period]
    lossSum = lossSum - loss[period]

// Up bodies as a share of all bodies. With no bodies at all it reads 50.
total = gainSum + lossSum
imi = total != 0 ? 100 * gainSum / total : 50

plot(imi, "IMI", #ffeb3b, width = 2)
