version 1
study("Jurik Volatility (JVOLTY)", precision = 4)

period = input(10, "Period", min = 1, max = 5000, step = 1, tooltip = "Number of bars used in the calculation.")
source = input(close, "Source")

// Constants fixed by the period. At a period of 1 the root is zero and its
// logarithm has no value, which the floor at zero covers.
root = sqrt(0.5 * (period - 1))
len1 = root > 0 ? max(log(root) / log(2) + 2, 0) : 0
pow1 = max(len1 - 2, 0.5)
len2 = root * len1
avgVoltyAlpha = 2 / (max(4 * period, 65) + 1)
div = 1 / (10 + 10 * min(max(period - 10, 0), 100) / 100)
rvoltyCap = pow(len1, 1 / pow1)

// Two adaptive bands that start on the first value of the source.
var upperBand = orElse(source, 0)
var lowerBand = orElse(source, 0)
var vSum = 0.0
var avgVolty = 0.0

del1 = source - upperBand
del2 = source - lowerBand
volty = max(abs(del1), abs(del2))

// A ten bar moving sum of the distance, then a slow exponential mean of it.
pastVolty = orElse(volty[10], 0)
vSum = vSum + (volty - pastVolty) * div
avgVolty = avgVolty + avgVoltyAlpha * (vSum - avgVolty)

// The distance as a multiple of its own average, floored at 1 and capped.
rvolty = avgVolty > 0 ? min(max(volty / avgVolty, 1), rvoltyCap) : 1.0

// The bands follow the source faster when the ratio is high.
kv = pow(len2 / (len2 + 1), sqrt(pow(rvolty, pow1)))
upperBand = del1 > 0 ? source : source - kv * del1
lowerBand = del2 < 0 ? source : source - kv * del2

plot(rvolty, "JVolty", #ffeb3b, width = 2)
