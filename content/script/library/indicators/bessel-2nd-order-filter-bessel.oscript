version 1
study("Bessel 2nd Order Filter (BESSEL)", overlay = true, precision = 2)

length = input(20, "Length", min = 2, max = 5000, step = 1)
source = input(close, "Source")

// Two-pole coefficients from a Bessel prototype.
safeLength = max(length, 2)
a = exp(-math.pi / safeLength)
c2 = 2 * a * math.cos(1.738 * math.pi / safeLength)
c3 = -a * a
c1 = 1 - c2 - c3

// The last two outputs, carried by hand.
var f1 = none
var f2 = none

// A missing price borrows the previous one, and missing outputs read as the
// nearest value that exists.
ssrc = orElse(source, orElse(source[1], 0))
filt1 = orElse(f1, ssrc)
filt2 = orElse(f2, filt1)

// The first two bars seed the recursion with the price itself.
filt = bar.index < 2 ? orElse(source, 0) : c1 * ssrc + c2 * filt1 + c3 * filt2

f2 = f1
f1 = filt

plot(filt, "Bessel", #ffeb3b, width = 2)
