version 1
study("Chande Forecast Oscillator", precision = 2)

period = input(14, "Period", min = 1, max = 5000, step = 1)
source = input(close, "Source")

// Least squares fit over the last `period` values, with x running from 0 on
// the oldest bar of the window to period - 1 on this bar. The sums are kept
// running: when the window is full the oldest value leaves, every remaining
// x drops by one, and the new value enters at x = period - 1.
var sumY = 0.0
var sumXY = 0.0
var filled = 0

sumX = period * (period - 1) / 2
sumX2 = period * (period - 1) * (2 * period - 1) / 6
denomX = period * sumX2 - sumX * sumX

if bar.index >= period
    sumY -= source[period]
    sumXY -= sumY
    sumXY += (period - 1) * source
else
    sumXY += filled * source
    filled += 1
sumY += source

// The forecast is the fitted line's value on this bar.
slope = denomX != 0 ? (period * sumXY - sumX * sumY) / denomX : none
intercept = (sumY - slope * sumX) / period
forecast = intercept + slope * (period - 1)

// Percentage distance of price from its forecast, once the window is full.
cfo = filled >= period and source != 0 ? 100 * (source - forecast) / source : none

level(0, "Zero Line", #787b86, style = "dashed")
plot(cfo, "CFO", #ffeb3b, width = 2)
