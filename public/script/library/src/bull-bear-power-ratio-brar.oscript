version 1
study("Bull-Bear Power Ratio (BRAR)", precision = 2)

period = input(26, "Period", min = 1, max = 5000, step = 1, tooltip = "Rolling window for summation (traditional: 26)")

// The previous close, or this bar's open on the first bar.
prevClose = bar.index > 0 ? close[1] : open
brNum = max(0.0, high - prevClose)
brDen = max(0.0, prevClose - low)
arNum = max(0.0, high - open)
arDen = max(0.0, open - low)

// Rolling sums over the last period bars, covering the bars seen so far
// until a full window exists.
var brNumSum = 0.0
var brDenSum = 0.0
var arNumSum = 0.0
var arDenSum = 0.0
brNumSum = brNumSum + brNum
brDenSum = brDenSum + brDen
arNumSum = arNumSum + arNum
arDenSum = arDenSum + arDen
if bar.index >= period
    brNumSum = brNumSum - brNum[period]
    brDenSum = brDenSum - brDen[period]
    arNumSum = arNumSum - arNum[period]
    arDenSum = arDenSum - arDen[period]

// Strength above the reference over strength below it, scaled to 100.
br = brDenSum != 0 ? (brNumSum / brDenSum) * 100.0 : 100.0
ar = arDenSum != 0 ? (arNumSum / arDenSum) * 100.0 : 100.0

plot(br, "BR", #00bcd4, width = 2)
plot(ar, "AR", #ffeb3b, width = 2)
level(100, "Equilibrium", #787b86, style = "dotted")
