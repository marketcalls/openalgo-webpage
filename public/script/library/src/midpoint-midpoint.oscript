version 1
study("Midpoint (MIDPOINT)", overlay = true, precision = 2)

source = input(close, "Source")
length = input(14, "Length", min = 1, max = 5000, step = 1)

// The centre of the source's own range over the window: the average of its
// highest and lowest value. Both are absent until the window is full, and so
// is the midpoint.
hiSource = highest(source, length)
loSource = lowest(source, length)
midpoint = (hiSource + loSource) * 0.5

plot(midpoint, "Midpoint", #ffeb3b, width = 2)
