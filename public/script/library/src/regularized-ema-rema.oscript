version 1
study("Regularized EMA (REMA)", overlay = true, precision = 2)

source = input(close, "Source")
period = input(10, "Period", min = 1, max = 5000, step = 1)
lambda = input(0.5, "Lambda", min = 0, max = 1, step = 0.1, tooltip = "Regularization parameter: 0 = maximum regularization, 1 = standard EMA")

smoothing = 2 / (period + 1)
lam = max(0, min(1, lambda))

// Seeded with the first source value. The previous value is taken from the
// current one before it is read, so the regularization term equals the current
// value and each step is an exponential step scaled by the smoothing factor times lambda.
var remaVal = none
var prevRema = none

if not isNone(source)
    if isNone(remaVal)
        remaVal = source
        prevRema = source
    else
        prevRema = remaVal
        emaComponent = smoothing * (source - remaVal) + remaVal
        regComponent = remaVal + (remaVal - prevRema)
        remaVal = lam * (emaComponent - regComponent) + regComponent

// A missing source value carries the previous value forward.
plot(remaVal, "REMA", #ffeb3b, width = 2)
