version 1
study("Kaufman's Adaptive Moving Average (KAMA)", overlay = true, precision = 2)

period = input(10, "Period", min = 1, max = 5000, step = 1)
source = input(close, "Source")
fastPeriod = input(2, "Fast EMA Period", min = 2, max = 5000, step = 1)
slowPeriod = input(30, "Slow EMA Period", min = 2, max = 5000, step = 1)

fastAlpha = 2 / (fastPeriod + 1)
slowAlpha = 2 / (slowPeriod + 1)

// The efficiency ratio: the net move over the period divided by the distance
// covered bar by bar over the same bars. It reads as 0 until both exist, and
// when nothing moved.
barMove = abs(source - source[1])
travel = sum(barMove, period)
netMove = abs(source - source[period])
er = orElse(travel != 0 ? netMove / travel : 0, 0)

// The smoothing constant slides between the slow and the fast weight with the
// efficiency ratio, and is squared.
sc = pow(er * (fastAlpha - slowAlpha) + slowAlpha, 2)

// The line starts at the first price. A fast period that is not faster than
// the slow one is refused, and the line is left empty.
var kamaState = none
kamaState = isNone(kamaState) ? source : kamaState + sc * (source - kamaState)
kamaLine = fastAlpha > slowAlpha ? kamaState : none

plot(kamaLine, "KAMA", #ffeb3b, width = 2)
