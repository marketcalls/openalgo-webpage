version 1
study("F-Distribution CDF (FDIST)", precision = 4)

source = input(close, "Source")
period = input(50, "Lookback Period", min = 2, max = 5000, step = 1, tooltip = "Min-max normalization window.")
d1 = input(5, "d1 (numerator df)", min = 0.1, max = 1000, step = 1, tooltip = "Numerator degrees of freedom.")
d2 = input(5, "d2 (denominator df)", min = 0.1, max = 1000, step = 1, tooltip = "Denominator degrees of freedom.")

len = max(2, floor(period))
df1 = max(0.1, d1)
df2 = max(0.1, d2)
shapeA = df1 / 2
shapeB = df2 / 2

// The natural log of the gamma function by the Lanczos approximation, g = 7
// with nine coefficients.
fn lnGamma(z) =>
    coeffs = [0.99999999999980993, 676.5203681218851, -1259.1392167224028, 771.32342877765313, -176.61502916214059, 12.507343278686905, -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7]
    zz = z - 1
    x = element(coeffs, 0)
    for i = 1 to 8
        x += element(coeffs, i) / (zz + i)
    t = zz + 7 + 0.5
    0.5 * log(2 * math.pi) + (zz + 0.5) * log(t) - t + log(x)

// The regularized incomplete beta function I_x(a, b), evaluated with Lentz's
// continued fraction. Past the mean the symmetry I_x(a, b) = 1 - I_(1-x)(b, a)
// is used, because the fraction converges faster there.
fn betaReg(x, a, b) =>
    if isNone(x) or isNone(a) or isNone(b)
        return none
    if x <= 0
        return 0.0
    if x >= 1
        return 1.0
    flip = x > (a + 1) / (a + b + 2)
    xx = flip ? 1 - x : x
    aa = flip ? b : a
    bb = flip ? a : b
    lnPfx = aa * log(xx) + bb * log(1 - xx) - log(aa) - lnGamma(aa) - lnGamma(bb) + lnGamma(aa + bb)
    front = exp(lnPfx)
    tiny = 1e-30
    f = tiny
    c = tiny
    d = 0.0
    for m = 0 to 199
        mm = floor(m / 2)
        term = 0.0
        if m == 0
            term = 1.0
        else if m % 2 == 0
            term = (mm * (bb - mm) * xx) / ((aa + 2 * mm - 1) * (aa + 2 * mm))
        else
            mf = mm + 1
            term = (-(aa + mf - 1) * (aa + bb + mf - 1) * xx) / ((aa + 2 * mf - 2) * (aa + 2 * mf - 1))
        d = 1 + term * d
        if abs(d) < tiny
            d = tiny
        d = 1 / d
        c = 1 + term / c
        if abs(c) < tiny
            c = tiny
        delta = c * d
        f *= delta
        if abs(delta - 1) < 1e-10
            break
    result = front * f
    flip ? 1 - result : result

// The extremes of the last len bars, skipping any bar without a value. Near
// the start of the chart the window is simply shorter, so there is no warmup.
minVal = source
maxVal = source
for j = 1 to len - 1
    v = source[j]
    if isNone(v)
        continue
    minVal = min(minVal, v)
    maxVal = max(maxVal, v)

// Where the source sits in its range, 0 at the bottom and 1 at the top, is
// taken as an F value and mapped to d1 x / (d1 x + d2), where the F
// distribution's cumulative probability equals I(d1 / 2, d2 / 2).
span = maxVal - minVal
pos01 = span > 0 ? (source - minVal) / span : 0.5
safeX = max(0, pos01)
denom = df1 * safeX + df2
fArg = denom > 0 ? (df1 * safeX) / denom : none

plot(betaReg(fArg, shapeA, shapeB), "FDIST", #ffeb3b, width = 2)
level(0.95, "Upper", #ff5252, style = "dashed")
level(0.5, "Midline", #787b86, style = "dashed")
level(0.05, "Lower", #4caf50, style = "dashed")
