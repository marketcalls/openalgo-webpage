version 1
study("RAVI: Chande Range Action Verification Index", precision = 2)

shortPeriod = input(7, "Short Period", min = 1, max = 100, step = 1, tooltip = "Fast SMA period (about 10% of the long period; default: 7)")
longPeriod = input(65, "Long Period", min = 2, max = 500, step = 1, tooltip = "Slow SMA period (about 13 weeks of daily bars; default: 65)")
threshold = input(3.0, "Threshold", min = 0, max = 20, step = 0.5, tooltip = "Trend/range classification level (default: 3%)")

smaShort = sma(close, shortPeriod)
smaLong = sma(close, longPeriod)

// The fast average must be the shorter one; otherwise nothing is drawn. A
// slow average at zero would divide by zero, so that bar is left empty too.
valid = shortPeriod < longPeriod and abs(smaLong) > 1e-10
ravi = valid ? abs(smaShort - smaLong) / abs(smaLong) * 100.0 : none

level(threshold, "Threshold", #ff5252, style = "dashed")
level(0, "Zero Line", #787b86, style = "dotted")
plot(ravi, "RAVI", #ffeb3b, width = 2)
