version 1
study("Tukey's Biweight Loss (TukeyBiweight)", precision = 4)

length = input(14, "Length", min = 1, max = 5000, step = 1)
c = input(4.685, "Threshold c", min = 0.1, max = 1000, step = 0.1, tooltip = "4.685=95% efficiency for normal; 6.0=more permissive")
actual = input(close, "Actual")
predicted = input(open, "Predicted")

// An absent value on either side counts as zero.
a = orElse(actual, 0)
p = orElse(predicted, 0)

// The bisquare loss rises smoothly with the error and stops growing at c:
// any miss larger than c costs the same c squared over six.
cSquaredOver6 = c * c / 6.0
err = a - p
ratio = err / c
oneMinusRatioSq = 1.0 - ratio * ratio
cubed = oneMinusRatioSq * oneMinusRatioSq * oneMinusRatioSq
loss = abs(err) > c ? cSquaredOver6 : cSquaredOver6 * (1.0 - cubed)

plot(sma(loss, length), "Tukey Biweight", #ffeb3b, width = 2)
level(0, "Zero", #787b86, style = "dashed")
