version 1
study("VWAP with Standard Deviation Bands", overlay = true, precision = 2)

source = input(hlc3, "Source")
sessionType = input("1D", "Session Reset", options = ["1m", "2m", "3m", "5m", "10m", "15m", "30m", "45m", "1H", "2H", "3H", "4H", "1D", "1W", "1M", "3M", "6M", "12M", "Never"])
numDevs = input(2, "Standard Deviations", min = 0.1, max = 5, step = 0.1, tooltip = "Number of standard deviations for bands.")

// The reset period as a key that changes when a new period begins, read in
// the chart's own timezone. Intraday periods count from midnight, weeks start
// on Monday, and "Never" accumulates from the first bar.

// The day number of the bar's calendar day, counted from the midnight that
// starts it, so a new day begins at midnight in that timezone.
dayIndex = round(date.startOfDay(time) / 86400000)
minuteOfDay = date.hour(time) * 60 + date.minute(time)
minutes = sessionType == "1m" ? 1 : sessionType == "2m" ? 2 : sessionType == "3m" ? 3 : sessionType == "5m" ? 5 : sessionType == "10m" ? 10 : sessionType == "15m" ? 15 : sessionType == "30m" ? 30 : sessionType == "45m" ? 45 : sessionType == "1H" ? 60 : sessionType == "2H" ? 120 : sessionType == "3H" ? 180 : sessionType == "4H" ? 240 : 0
periodKey = minutes > 0 ? dayIndex * 10000 + floor(minuteOfDay / minutes) : sessionType == "1D" ? dayIndex : sessionType == "1W" ? floor((dayIndex + 3) / 7) : sessionType == "1M" ? date.year(time) * 12 + date.month(time) : sessionType == "3M" ? date.year(time) * 4 + floor((date.month(time) - 1) / 3) : sessionType == "6M" ? date.year(time) * 2 + (date.month(time) > 6 ? 1 : 0) : sessionType == "12M" ? date.year(time) : 0
reset = bar.index == 0 or periodKey != periodKey[1]

// A missing price or volume is read as zero.
price = orElse(source, 0)
vol = orElse(volume, 0)

// Running volume weighted sums of price and of price squared since the last
// reset. A bar with no volume adds nothing.
var sumPv = 0.0
var sumVol = 0.0
var sumPv2 = 0.0
if reset
    sumPv = vol > 0 ? price * vol : 0.0
    sumVol = vol > 0 ? vol : 0.0
    sumPv2 = vol > 0 ? price * price * vol : 0.0
else if vol > 0
    sumPv = sumPv + price * vol
    sumVol = sumVol + vol
    sumPv2 = sumPv2 + price * price * vol

// With no volume at all the average falls back to the source itself and the
// bands collapse onto it.
vwapValue = sumVol > 0 ? sumPv / sumVol : source
bandVariance = sumVol > 0 ? sumPv2 / sumVol - vwapValue * vwapValue : 0
stddev = sqrt(max(0, bandVariance))

plot(vwapValue, "VWAP", #ffeb3b, width = 2)
top = plot(vwapValue + numDevs * stddev, "Upper Band", #ef5350, width = 1)
bottom = plot(vwapValue - numDevs * stddev, "Lower Band", #26a69a, width = 1)
fill(top, bottom, #787b86, opacity = 0.1)
