version 1
study("High-Low Volatility (HLV)", precision = 4)

length = input(20, "Length", min = 1, max = 5000, step = 1, tooltip = "Period for smoothing the Parkinson estimator.")
annualize = input(true, "Annualize Volatility", tooltip = "Annualize the volatility output.")
annualPeriods = input(252, "Annual Periods", min = 1, max = 100000, step = 1, tooltip = "Number of periods in a year for annualization (252 for daily, 52 for weekly).")

// The squared log range scaled by 1 / (4 ln 2).
logRange = log(high) - log(low)
rangeEstimator = 0.3606737602 * logRange * logRange

// A running average of the estimator with weight 1 / length, seeded with the
// first value, and the weight that seed still carries.
rmaAlpha = 1 / length
var rawRma = 0.0
var eRma = 0.0
rawRma = bar.index == 0 ? rangeEstimator : (rawRma * (length - 1) + rangeEstimator) / length
eRma = bar.index == 0 ? 1 - rmaAlpha : (1 - rmaAlpha) * eRma

// Divide out the weight the average has not gathered yet.
smoothed = eRma > 1e-10 ? rawRma / (1 - eRma) : rawRma
volatility = smoothed >= 0 ? sqrt(smoothed) : none

plot(annualize ? volatility * sqrt(annualPeriods) : volatility, "HLV", #ffeb3b, width = 2)
