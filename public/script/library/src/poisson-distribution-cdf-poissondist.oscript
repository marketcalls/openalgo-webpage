version 1
study("Poisson Distribution CDF (POISSONDIST)", precision = 4)

source = input(close, "Source")
period = input(50, "Lookback Period", min = 2, max = 5000, step = 1, tooltip = "Min-max normalization window.")
k = input(5, "Threshold (k)", min = 0, max = 1000, step = 1, tooltip = "P(X <= k); number of events threshold.")
lambdaScale = input(10, "Lambda Scale", min = 0.01, max = 1000, step = 0.5, tooltip = "Scales normalized price to lambda; higher = wider event-rate range.")

level(0.5, "Midline", #787b86, style = "dotted")
level(0.95, "Upper", #ef5350, style = "dashed")
level(0.05, "Lower", #26a69a, style = "dashed")

// Natural log of the gamma function by the Lanczos approximation, g = 7 with
// nine coefficients.
fn lnGamma(z) =>
    zz = z - 1.0
    x = 0.99999999999980993
    x = x + 676.5203681218851 / (zz + 1)
    x = x + -1259.1392167224028 / (zz + 2)
    x = x + 771.32342877765313 / (zz + 3)
    x = x + -176.61502916214059 / (zz + 4)
    x = x + 12.507343278686905 / (zz + 5)
    x = x + -0.13857109526572012 / (zz + 6)
    x = x + 9.9843695780195716e-6 / (zz + 7)
    x = x + 1.5056327351493116e-7 / (zz + 8)
    t = zz + 7.0 + 0.5
    0.5 * log(2.0 * math.pi) + (zz + 0.5) * log(t) - t + log(x)

// Regularized lower incomplete gamma P(a, x) by its series expansion.
fn gammaSeries(a, x) =>
    ap = a
    total = 1.0 / a
    term = total
    i = 1
    while i <= 200
        ap = ap + 1.0
        term = term * x / ap
        total = total + term
        if abs(term) < abs(total) * 1e-10
            break
        i = i + 1
    exp(a * log(x) - x - lnGamma(a)) * total

// Regularized upper incomplete gamma Q(a, x) by the modified Lentz continued
// fraction.
fn gammaCF(a, x) =>
    tiny = 1e-30
    b0 = x + 1.0 - a
    c = 1.0 / tiny
    d = b0 < tiny ? 1.0 / tiny : 1.0 / b0
    f = d
    i = 1
    while i <= 200
        ai = 0 - i * (i - a)
        bi = x + 2.0 * i + 1.0 - a
        d = bi + ai * d
        if abs(d) < tiny
            d = tiny
        d = 1.0 / d
        c = bi + ai / c
        if abs(c) < tiny
            c = tiny
        delta = c * d
        f = f * delta
        if abs(delta - 1.0) < 1e-10
            break
        i = i + 1
    exp(a * log(x) - x - lnGamma(a)) * f

fn gammaP(a, x) =>
    x <= 0.0 ? 0.0 : x < a + 1.0 ? gammaSeries(a, x) : 1.0 - gammaCF(a, x)

// Where the source sits between its lowest and highest present values over
// the window, from 0 at the low to 1 at the high. A flat window, or a missing
// source, reads 0.5.
lowVal = source
highVal = source
window = floor(period)
j = 1
while j < window and j <= bar.index
    prior = source[j]
    if not isNone(prior)
        if prior < lowVal
            lowVal = prior
        if prior > highVal
            highVal = prior
    j = j + 1
spread = highVal - lowVal
position = not isNone(source) and spread > 0.0 ? (source - lowVal) / spread : 0.5

// The position, scaled, is the event rate. The plot is the chance of at most
// k events at that rate; a rate of zero puts every outcome at zero events.
kk = max(0, floor(k))
rate = max(0.0, position * lambdaScale)
poissonCdf = rate <= 0.0 ? 1.0 : 1.0 - gammaP(kk + 1, rate)

plot(poissonCdf, "POISSONDIST", #ffeb3b, width = 2)
