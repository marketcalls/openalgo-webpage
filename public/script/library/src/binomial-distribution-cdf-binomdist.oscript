version 1
study("Binomial Distribution CDF (BINOMDIST)", precision = 4)

source = input(close, "Source")
period = input(50, "Lookback Period", min = 2, max = 5000, step = 1, tooltip = "Min-max normalization window")
trials = input(20, "Trials (n)", min = 1, max = 1000, step = 1, tooltip = "Number of Bernoulli trials")
threshold = input(10, "Threshold (k)", min = 0, max = 1000, step = 1, tooltip = "Compute P(X <= k)")

len = max(2, floor(period))
n = max(1, floor(trials))
k = max(0, floor(threshold))

// The natural log of the gamma function by the Lanczos approximation, g = 7
// with nine coefficients.
fn lnGamma(z) =>
    coeffs = [0.99999999999980993, 676.5203681218851, -1259.1392167224028, 771.32342877765313, -176.61502916214059, 12.507343278686905, -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7]
    zz = z - 1.0
    x = element(coeffs, 0)
    for i = 1 to 8
        x += element(coeffs, i) / (zz + i)
    t = zz + 7.0 + 0.5
    0.5 * log(2.0 * math.pi) + (zz + 0.5) * log(t) - t + log(x)

// The extremes of the last len bars, skipping any bar without a value. Near
// the start of the chart the window is simply shorter, so there is no warmup.
minVal = source
maxVal = source
for j = 1 to len - 1
    v = source[j]
    if isNone(v)
        continue
    minVal = min(minVal, v)
    maxVal = max(maxVal, v)

// Where the source sits in its range is the success probability p.
span = maxVal - minVal
p = span > 0.0 ? (source - minVal) / span : 0.5

// P(X <= k) for n trials: the sum of C(n, i) p^i (1 - p)^(n - i) for i up to
// k, each term built in logs. At p = 0 or p = 1 the answer is exact.
kk = min(k, n)
lnFactN = lnGamma(n + 1)
cdf = 0.0
if p > 0.0 and p < 1.0
    lnP = log(p)
    lnQ = log(1.0 - p)
    for i = 0 to kk
        lnC = lnFactN - lnGamma(i + 1) - lnGamma(n - i + 1)
        cdf += exp(lnC + i * lnP + (n - i) * lnQ)
    cdf = min(cdf, 1.0)
else if p <= 0.0
    cdf = 1.0
else
    cdf = k >= n ? 1.0 : 0.0

plot(isNone(p) ? none : cdf, "BINOMDIST", #ffeb3b, width = 2)
level(0.5, "Midline", #787b86, style = "dashed")
level(0.95, "Upper", #ef5350, style = "dashed")
level(0.05, "Lower", #26a69a, style = "dashed")
