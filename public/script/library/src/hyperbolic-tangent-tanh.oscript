version 1
study("Hyperbolic Tangent (TANH)", precision = 4)

source = input(close, "Source")
steepness = input(0.5, "Steepness (k)", min = 0.1, max = 100, step = 0.1, tooltip = "Higher k makes the curve steeper around the inflection point.")

// The inflection point is the 200-bar simple average of the source.
inflection = sma(source, 200)
y = steepness * (source - inflection)

// tanh(y) = (1 - e) / (1 + e) with e = exp(-2|y|), signed like y. Written this
// way the exponential never overflows: far from the average e is zero and the
// result is exactly plus or minus one.
e = exp(-2 * abs(y))
magnitude = (1 - e) / (1 + e)
tanhValue = y < 0 ? -magnitude : magnitude

plot(tanhValue, "Tanh", #ffeb3b, width = 2)
