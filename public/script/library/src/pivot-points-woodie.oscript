version 1
study("Pivot Points (Woodie)", overlay = true, precision = 2)

timeframe = input("D", "Pivot Timeframe", options = ["D", "W", "M"])
showPp = input(true, "Show Pivot Point")
showR1 = input(true, "Show R1")
showR2 = input(true, "Show R2")
showR3 = input(true, "Show R3")
showS1 = input(true, "Show S1")
showS2 = input(true, "Show S2")
showS3 = input(true, "Show S3")

// The period each bar belongs to: its day, its Monday-start week or its month,
// on the chart's calendar.
periodKey = timeframe == "W" ? date.startOfWeek(time) : timeframe == "M" ? date.startOfMonth(time) : date.startOfDay(time)

// The period being built, and the last completed one. The levels of every bar
// come from the completed period, so nothing on a bar changes as it forms.
var curKey = none
var curHi = none
var curLo = none
var curCl = none
var prevHi = none
var prevLo = none
var prevCl = none

if isNone(curKey) or periodKey != curKey
    if not isNone(curKey)
        prevHi = curHi
        prevLo = curLo
        prevCl = curCl
    curKey = periodKey
    curHi = high
    curLo = low
    curCl = close
else
    curHi = max(curHi, high)
    curLo = min(curLo, low)
    curCl = close

// The pivot weights the previous close twice.
pivot = (prevHi + prevLo + 2 * prevCl) / 4
span = prevHi - prevLo

plot(showPp ? pivot : none, "PP", #ffeb3b, width = 2, style = "step")
plot(showR1 ? 2 * pivot - prevLo : none, "R1", #ef5350, width = 1, style = "step")
plot(showR2 ? pivot + span : none, "R2", #ef5350, width = 1, style = "step")
plot(showR3 ? prevHi + 2 * (pivot - prevLo) : none, "R3", #ef5350, width = 1, style = "step")
plot(showS1 ? 2 * pivot - prevHi : none, "S1", #26a69a, width = 1, style = "step")
plot(showS2 ? pivot - span : none, "S2", #26a69a, width = 1, style = "step")
plot(showS3 ? prevLo - 2 * (prevHi - pivot) : none, "S3", #26a69a, width = 1, style = "step")
