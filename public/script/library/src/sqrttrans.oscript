version 1
study("Square Root Transformation (SQRT)", precision = 2)

source = input(close, "Source")

// The square root of the source. A negative value has no real root and
// leaves a gap.
root = source < 0 ? none : sqrt(source)

plot(root, "Square Root Transformation", #ffeb3b, width = 2)
