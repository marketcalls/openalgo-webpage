version 1
study("Hann FIR Filter (HANN)", overlay = true, precision = 2)

length = input(10, "Length", min = 1, max = 5000, step = 1)
source = input(close, "Source")

len = max(1, floor(length))

// Before the window is full the filter uses the first p taps only, so it
// answers from the first bar. Tap i weighs 0.5 * (1 - cos(2 pi i / (len - 1))),
// the oldest bar in the window first. A length of 1 has no defined tap.
p = min(bar.index + 1, len)
acc = 0.0
weightSum = 0.0
for i = 0 to p - 1
    price = source[p - 1 - i]
    weight = len > 1 ? 0.5 * (1 - math.cos((2 * math.pi * i) / (len - 1))) : none
    if not isNone(price) and not isNone(weight)
        acc = acc + price * weight
        weightSum = weightSum + weight
value = weightSum == 0 ? source : acc / weightSum
hann = orElse(value, source)

plot(hann, "HANN", #ffeb3b, width = 2)
