version 1
study("Weighted Moving Average (WMA)", overlay = true, precision = 2)

period = input(10, "Period", min = 1, max = 5000, step = 1)
source = input(close, "Source")

// Two running sums: the plain sum of the window and the weighted sum, where
// the newest value carries weight period and the oldest carries 1. While the
// window is still filling the weights run 1 to the number of bars seen, so
// the line starts on the first bar. A missing value counts as zero.
var total = 0.0
var weightedTotal = 0.0
var filled = 0
var norm = 0.0
current = orElse(source, 0)
if bar.index >= period
    oldest = orElse(source[period], 0)
    previousTotal = total
    total = total - oldest + current
    weightedTotal = weightedTotal - previousTotal + period * current
else
    filled += 1
    total += current
    weightedTotal += filled * current
    norm = filled * (filled + 1) * 0.5

wmaValue = norm > 0 ? weightedTotal / norm : none

plot(wmaValue, "WMA", #ffeb3b, width = 2)
