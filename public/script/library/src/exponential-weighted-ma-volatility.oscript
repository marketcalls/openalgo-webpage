version 1
study("Exponential Weighted MA Volatility", precision = 4)

source = input(close, "Source")
length = input(20, "Length", min = 1, max = 5000, step = 1, tooltip = "Period for the EWMA calculation.")
annualize = input(true, "Annualize Volatility", tooltip = "Annualize the volatility output.")
annualPeriods = input(252, "Annual Periods", min = 1, max = 100000, step = 1, tooltip = "Number of periods in a year for annualization: 252 for daily, 52 for weekly.")

// The log return, read as zero where there is none (the first bar).
logReturn = orElse(log(source / source[1]), 0)
squaredReturn = logReturn * logReturn

// A running average of the squared returns with weight 1 / length, seeded with the
// first value, and the weight that seed still carries.
rmaAlpha = 1 / length
var rawRma = 0.0
var eRma = 0.0
rawRma = bar.index == 0 ? squaredReturn : (rawRma * (length - 1) + squaredReturn) / length
eRma = bar.index == 0 ? 1 - rmaAlpha : (1 - rmaAlpha) * eRma

// Divide out the weight that has not accumulated yet.
corrected = eRma > 1e-10 and 1 - eRma > 1e-10 ? rawRma / (1 - eRma) : rawRma
volatility = sqrt(corrected)

plot(annualize ? volatility * sqrt(annualPeriods) : volatility, "EWMA Volty", #ffeb3b, width = 2)
