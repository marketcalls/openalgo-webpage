version 1
study("Ehlers 2-Pole Super Smoother Filter (SSF2)", overlay = true, precision = 2)

length = input(20, "Length", min = 1, max = 5000, step = 1)
source = input(close, "Source")

// Two-pole coefficients, damped by the square root of two.
arg = sqrt(2) * math.pi / length
expArg = exp(-arg)
c2 = 2 * expArg * math.cos(arg)
c3 = -expArg * expArg
c1 = 1 - c2 - c3

// The last two outputs that were computed, carried by hand.
var prev1 = none
var prev2 = none

// Every missing term takes the nearest sample that exists, so on the first
// bar the filter returns the price and settles from there.
ssrc = orElse(source, source[1])
src1 = orElse(source[1], ssrc)
src2 = orElse(source[2], src1)
hist1 = orElse(prev1, src1)
hist2 = orElse(prev2, src2)

ssf = c1 * ssrc + c2 * hist1 + c3 * hist2

if not isNone(ssf)
    prev2 = prev1
    prev1 = ssf

plot(ssf, "SSF2", #ffeb3b, width = 2)
