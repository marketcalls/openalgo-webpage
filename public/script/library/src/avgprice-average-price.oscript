version 1
study("AVGPRICE: Average Price", overlay = true, precision = 2)

// The plain mean of the bar's four prices: open, high, low and close each
// carry a quarter of the weight. One value per bar, with no warmup.
avgPrice = (open + high + low + close) * 0.25

plot(avgPrice, "AvgPrice", #2196f3, width = 2)
