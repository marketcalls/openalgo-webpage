version 1
study("Pivot Points (Extended)", overlay = true, precision = 2)

timeframe = input("D", "Pivot Timeframe", options = ["D", "W", "M"], tooltip = "The period whose high, low and close the pivots are built from.")
showPp = input(true, "Show Pivot Point")
showR1 = input(true, "Show R1", group = "Resistance")
showR2 = input(true, "Show R2", group = "Resistance")
showR3 = input(true, "Show R3", group = "Resistance")
showR4 = input(true, "Show R4", group = "Resistance")
showR5 = input(true, "Show R5", group = "Resistance")
showS1 = input(true, "Show S1", group = "Support")
showS2 = input(true, "Show S2", group = "Support")
showS3 = input(true, "Show S3", group = "Support")
showS4 = input(true, "Show S4", group = "Support")
showS5 = input(true, "Show S5", group = "Support")

// The period each bar belongs to: its day, its Monday-start week or its month,
// on the chart's calendar.
periodKey = timeframe == "W" ? date.startOfWeek(time) : timeframe == "M" ? date.startOfMonth(time) : date.startOfDay(time)

// The period being built, and the last completed one. The levels of every bar
// come from the completed period, so nothing on a bar changes as it forms.
var curKey = none
var curHi = none
var curLo = none
var curCl = none
var prevHi = none
var prevLo = none
var prevCl = none

if isNone(curKey) or periodKey != curKey
    if not isNone(curKey)
        prevHi = curHi
        prevLo = curLo
        prevCl = curCl
    curKey = periodKey
    curHi = high
    curLo = low
    curCl = close
else
    curHi = max(curHi, high)
    curLo = min(curLo, low)
    curCl = close

// The classic pivot, carried out to five levels on each side.
pivot = (prevHi + prevLo + prevCl) / 3
hlRange = prevHi - prevLo

plot(showPp ? pivot : none, "PP", #ffeb3b, width = 2, style = "step")
plot(showR1 ? 2 * pivot - prevLo : none, "R1", #ff5252, width = 1, style = "step")
plot(showR2 ? pivot + hlRange : none, "R2", #ff5252, width = 1, style = "step")
plot(showR3 ? prevHi + 2 * (pivot - prevLo) : none, "R3", #ff5252, width = 1, style = "step")
plot(showR4 ? prevHi + 3 * (pivot - prevLo) : none, "R4", #ff5252, width = 1, style = "step")
plot(showR5 ? prevHi + 4 * (pivot - prevLo) : none, "R5", #ff5252, width = 1, style = "step")
plot(showS1 ? 2 * pivot - prevHi : none, "S1", #4caf50, width = 1, style = "step")
plot(showS2 ? pivot - hlRange : none, "S2", #4caf50, width = 1, style = "step")
plot(showS3 ? prevLo - 2 * (prevHi - pivot) : none, "S3", #4caf50, width = 1, style = "step")
plot(showS4 ? prevLo - 3 * (prevHi - pivot) : none, "S4", #4caf50, width = 1, style = "step")
plot(showS5 ? prevLo - 4 * (prevHi - pivot) : none, "S5", #4caf50, width = 1, style = "step")
