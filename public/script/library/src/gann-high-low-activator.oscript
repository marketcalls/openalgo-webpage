version 1
study("Gann High-Low Activator", overlay = true, precision = 2)

period = input(3, "Period", min = 1, max = 100, step = 1, tooltip = "SMA lookback period (default: 3)")

smaHigh = sma(high, period)
smaLow = sma(low, period)

// The trend turns up on a close above the average of the highs and down on a
// close below the average of the lows; between them it holds. It starts up
// unless the first bar already sits on or below the average of the lows.
var trendState = 0
if trendState == 0
    trendState = close >= smaHigh ? 1 : close <= smaLow ? -1 : 1
if close > smaHigh
    trendState = 1
else if close < smaLow
    trendState = -1

// In an uptrend the line trails under price at the average of the lows, in a
// downtrend it sits above price at the average of the highs.
activator = trendState == 1 ? smaLow : smaHigh
plot(activator, "GHLA", trendState == -1 ? #ef5350 : #26a69a, width = 2)

// A flip marks the bar it happens on. The first bar always counts as a flip.
flipped = trendState != orElse(trendState[1], 0)
if flipped and trendState == 1
    signal("BUY", color = #26a69a, at = "below", shape = "label")
if flipped and trendState == -1
    signal("SELL", color = #ef5350, at = "above", shape = "label")
