version 1
study("Relative Absolute Error (RAE)", precision = 4)

source = input(close, "Source")
period = input(100, "Period", min = 1, max = 4000, step = 1, tooltip = "Window for the error averaging, and the length of the EMA used as the forecast.")

// The total and the count of the present values among the last p bars.
// Before p bars have passed the window is everything so far, so both answer
// from the first bar.
fn windowSum(x, p) =>
    var running = 0.0
    if not isNone(x)
        running = running + x
    rolled = sumSkip(x, p)
    bar.index < p - 1 ? running : rolled

fn windowCount(x, p) =>
    var n = 0
    if not isNone(x)
        n = n + 1
    rolled = countPresent(x, p)
    bar.index < p - 1 ? n : rolled

// The forecast is an exponential mean seeded with the simple average of its
// first period values, so it has no value through the warmup.
forecast = ema(source, period)
window = min(period, 4000)

// The naive baseline is the mean of the window, which holds this bar too: an
// expanding mean until the window fills, a rolling one after.
srcCount = windowCount(source, window)
srcSum = windowSum(source, window)
baseMean = srcCount > 0 ? srcSum / srcCount : source

absError = abs(source - forecast)
absBaseline = abs(source - baseMean)

// Totals of the present values in the window. With none present the bar's
// own value stands in.
errCount = windowCount(absError, window)
errSum = windowSum(absError, window)
baseCount = windowCount(absBaseline, window)
baseSum = windowSum(absBaseline, window)
totalError = errCount > 0 ? errSum : absError
totalBaseline = baseCount > 0 ? baseSum : absBaseline

// Forecast error over baseline error. A baseline of zero, or none at all,
// reads as 1.
rae = isNone(totalBaseline) or totalBaseline == 0 ? 1.0 : totalError / totalBaseline

plot(rae, "RAE", #ef5350, width = 2, style = "area")
plot(forecast, "EMA", #ffeb3b, width = 1, overlay = true)
