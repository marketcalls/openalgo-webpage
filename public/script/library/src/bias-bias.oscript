version 1
study("Bias (BIAS)", precision = 4)

source = input(close, "Source")
length = input(20, "Length", min = 1, max = 5000, step = 1)

len = max(1, floor(length))

// A running sum over the last len values: the value leaving the window is
// taken out before the new one goes in.
var total = 0.0
if bar.index >= len
    total -= source[len]
total += orElse(source, 0)

// Before the window is full the mean is taken over the bars seen so far, so
// the line starts on the first bar.
filled = min(bar.index + 1, len)
movingAverage = total / max(filled, 1)

bias = movingAverage != 0 ? (source - movingAverage) / movingAverage : none

plot(bias, "BIAS", #ffeb3b, width = 2)
