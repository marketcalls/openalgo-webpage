version 1
study("Ehlers 2-Pole Butterworth Filter (BUTTER2)", overlay = true, precision = 2)

length = input(20, "Length", min = 2, max = 5000, step = 1)
source = input(close, "Source")

// Biquad lowpass coefficients with a maximally flat passband.
safeLength = max(2, length)
omega = 2 * math.pi / safeLength
sinOmega = math.sin(omega)
cosOmega = math.cos(omega)
damping = sinOmega / sqrt(2)
a0 = 1 + damping
a1 = -2 * cosOmega
a2 = 1 - damping
b0 = (1 - cosOmega) / 2
b1 = 1 - cosOmega
b2 = (1 - cosOmega) / 2

// The last two outputs, carried by hand.
var f1 = none
var f2 = none

// Each missing term falls back to the one before it.
ssrc = orElse(source, orElse(source[1], 0))
src1 = orElse(source[1], ssrc)
src2 = orElse(source[2], src1)
filt1 = orElse(f1, ssrc)
filt2 = orElse(f2, filt1)

// The first two bars seed the recursion with the price itself.
filt = bar.index < 2 ? orElse(source, 0) : (b0 * ssrc + b1 * src1 + b2 * src2 - a1 * filt1 - a2 * filt2) / a0

f2 = f1
f1 = filt

plot(filt, "Butterworth 2-Pole", #ffeb3b, width = 2)
