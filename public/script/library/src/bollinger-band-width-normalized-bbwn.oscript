version 1
study("Bollinger Band Width Normalized (BBWN)", precision = 3)

period = input(20, "Period", min = 1, max = 5000, step = 1)
source = input(close, "Source")
multiplier = input(2.0, "StdDev Multiplier", min = 0.001, max = 100, step = 0.1)
lookback = input(252, "Lookback Period", min = 1, max = 5000, step = 1, tooltip = "Window of past band widths the current width is rescaled against.")

// Running sums of the source and its square over the last `period` bars. The
// window grows from one value to `period`, and a missing source counts as 0.
value = orElse(source, 0)
var sumValue = 0.0
var sumSq = 0.0
if bar.index >= period
    oldest = value[period]
    sumValue = sumValue - oldest
    sumSq = sumSq - oldest * oldest
sumValue = sumValue + value
sumSq = sumSq + value * value
filled = min(bar.index + 1, period)

// Population deviation; the band width is twice the multiplied deviation,
// and zero while the window holds a single value.
basis = sumValue / filled
dev = filled > 1 ? multiplier * sqrt(max(0, sumSq / filled - basis * basis)) : 0
bbw = 2 * dev

// The width rescaled inside its own range over the last `lookback` bars, or
// every bar so far while fewer exist: 0 at the narrowest, 1 at the widest,
// and 0.5 when every width in the window is the same.
span = min(lookback, bar.index + 1)
minVal = bbw
maxVal = bbw
for k = 1 to span - 1
    w = bbw[k]
    if w < minVal
        minVal = w
    if w > maxVal
        maxVal = w
rangeVal = maxVal - minVal
bbwn = rangeVal > 0 ? (bbw - minVal) / rangeVal : 0.5

plot(bbwn, "BBWN", #ffeb3b, width = 2)
