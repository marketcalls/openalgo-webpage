version 1
study("Logarithmic Transformation (LOG)", precision = 4)

source = input(close, "Source")

// The natural logarithm exists only above zero, so a bar whose source is zero
// or negative is left blank.
logValue = source > 0 ? log(source) : none

plot(logValue, "Log Transformation", #ffeb3b, width = 2)
