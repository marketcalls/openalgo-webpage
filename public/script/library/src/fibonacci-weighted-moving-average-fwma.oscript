version 1
study("Fibonacci Weighted Moving Average (FWMA)", overlay = true, precision = 2)

period = input(10, "Period", min = 1, max = 5000, step = 1, tooltip = "Number of Fibonacci weights in the window.")
source = input(close, "Source")

// The Fibonacci numbers 1, 1, 2, 3, 5 and on, one per bar of the longest
// window, built once on the first bar.
var fibs: array<number> = []
if size(fibs) == 0
    prev2 = 0.0
    prev1 = 1.0
    for i = 0 to period - 1
        fib = i <= 1 ? 1.0 : prev1 + prev2
        push(fibs, fib)
        prev2 = prev1
        prev1 = fib

// The window grows with the chart until it holds period bars. Of len taps,
// the newest bar takes the len-th Fibonacci number and the oldest takes 1.
len = min(bar.index + 1, period)
total = 0.0
weightSum = 0.0
for j = 0 to len - 1
    price = source[j]
    if isNone(price)
        continue
    w = element(fibs, len - 1 - j)
    total += price * w
    weightSum += w

// An empty window falls back to the current value.
fwma = weightSum != 0 ? total / weightSum : source

plot(fwma, "FWMA", #ffeb3b, width = 2)
