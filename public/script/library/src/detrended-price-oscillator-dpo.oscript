version 1
study("Detrended Price Oscillator (DPO)", precision = 2)

source = input(close, "Source")
period = input(20, "Period", min = 1, max = 5000, step = 1)

displacement = floor(period / 2) + 1

// A simple mean over `period` bars in which any slot reaching back before the
// first bar is filled with this bar's value, so the mean exists from bar 0.
total = cum(orElse(source, 0))
inWindow = min(bar.index + 1, period)
before = bar.index >= period ? total[period] : 0
paddedSma = (total - before + (period - inWindow) * source) / period

// Price minus the mean as it stood `displacement` bars ago, which removes the
// trend and leaves the shorter cycles.
level(0, "Zero Line", #787b86, style = "dotted")
plot(source - paddedSma[displacement], "DPO", #ffeb3b, width = 2)
