version 1
study("Momentum (MOM)", precision = 2)

length = input(10, "Length", min = 1, max = 5000, step = 1)
source = input(close, "Source")

// The difference between the source now and the source length bars ago. It
// answers only once both values exist, so the first length bars are blank.
momValue = source - source[length]

plot(momValue, "MOM", #ffeb3b, width = 2)
