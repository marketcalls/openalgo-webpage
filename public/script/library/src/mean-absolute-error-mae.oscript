version 1
study("Mean Absolute Error (MAE)", precision = 2)

source = input(close, "Source")
period = input(100, "Period", min = 1, max = 4000, step = 1)

// The reference is an exponential mean seeded with the simple average of its
// first `period` values, so it has no value through the warmup.
reference = ema(source, period)

// The absolute gap between price and its reference, absent until the
// reference exists.
absErr = abs(source - reference)

// The error is averaged over the last `period` bars, at most 4000, counting
// only the bars that carry an error.
window = min(period, 4000)
mae = avgSkip(absErr, window)

plot(mae, "MAE", #ffeb3b, width = 2, style = "area")
plot(reference, "EMA", #ff9800, width = 1, overlay = true)
