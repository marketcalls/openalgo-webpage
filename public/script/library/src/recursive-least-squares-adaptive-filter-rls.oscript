version 1
study("Recursive Least Squares Adaptive Filter (RLS)", overlay = true, precision = 2)

order = input(16, "Filter Order (taps)", min = 2, max = 64, step = 1, tooltip = "Number of adaptive FIR weights. More taps model a longer memory of past bars.")
lambda = input(0.99, "Forgetting Factor (Lambda)", min = 0.9, max = 1, step = 0.005, tooltip = "Closer to 1 remembers more history; lower values adapt faster to a regime change.")
source = input(close, "Source")

invLambda = 1 / lambda

// The weights start at zero. The inverse correlation matrix starts at
// 100 times the identity and is held row by row in one flat array.
var weights: array<number> = []
var pm: array<number> = []
var xv: array<number> = []
var px: array<number> = []
var gainV: array<number> = []
var armed = false
if size(weights) == 0
    for i = 0 to order - 1
        push(weights, 0.0)
        push(xv, 0.0)
        push(px, 0.0)
        push(gainV, 0.0)
    for i = 0 to order * order - 1
        push(pm, 0.0)
    for i = 0 to order - 1
        set(pm, i * order + i, 100.0)

// The input vector is the previous order values, zero before they exist.
for i = 0 to order - 1
    set(xv, i, orElse(source[i + 1], 0))

// The prediction is taken before this bar updates the weights.
prediction = 0.0
for i = 0 to order - 1
    prediction += element(weights, i) * element(xv, i)
predicted = armed

err = orElse(source, 0) - prediction

// Gain vector k = P x / (lambda + x' P x).
for i = 0 to order - 1
    rowSum = 0.0
    for j = 0 to order - 1
        rowSum += element(pm, i * order + j) * element(xv, j)
    set(px, i, rowSum)
denom = lambda
for i = 0 to order - 1
    denom += element(xv, i) * element(px, i)
invDenom = denom > 1e-30 ? 1 / denom : 0
for i = 0 to order - 1
    set(gainV, i, element(px, i) * invDenom)

// Move the weights by the gain times the error. The line is drawn once any
// weight has left zero.
for i = 0 to order - 1
    set(weights, i, element(weights, i) + element(gainV, i) * err)
if not armed
    for i = 0 to order - 1
        if element(weights, i) != 0
            armed = true
            break

// P = (P - k (P x)') / lambda.
for i = 0 to order - 1
    gi = element(gainV, i)
    for j = 0 to order - 1
        idx = i * order + j
        set(pm, idx, invLambda * (element(pm, idx) - gi * element(px, j)))

plot(predicted ? prediction : none, "RLS", #ff9800, width = 2)
