version 1
study("Exponential Distribution CDF (EXPDIST)", precision = 4)

source = input(close, "Source")
period = input(50, "Lookback Period", min = 2, max = 5000, step = 1, tooltip = "Min-max normalization window")
lambda = input(3.0, "Lambda", min = 0.01, max = 100, step = 0.1, tooltip = "Rate parameter; higher = faster rise toward 1")

len = max(2, min(5000, floor(period)))
rate = max(0.01, lambda)

// The extremes of the last len bars, skipping any bar without a value. Near
// the start of the chart the window is simply shorter, so there is no warmup.
minVal = source
maxVal = source
for j = 1 to len - 1
    v = source[j]
    if isNone(v)
        continue
    minVal = min(minVal, v)
    maxVal = max(maxVal, v)

// Where the source sits in its own range, 0 at the bottom and 1 at the top,
// read through the exponential cumulative distribution 1 - e^(-rate * x).
span = maxVal - minVal
x = span > 0 ? (source - minVal) / span : 0.5
cdf = x <= 0 ? 0 : 1 - exp(-rate * x)

plot(cdf, "EXPDIST", #ffeb3b, width = 2)
level(0.95, "Upper", #ef5350)
level(0.5, "Midline", #787b86)
level(0.05, "Lower", #4caf50)
