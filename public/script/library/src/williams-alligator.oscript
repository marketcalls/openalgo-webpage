version 1
study("Williams Alligator", overlay = true, precision = 2)

source = input(hlc3, "Source")
jawPeriod = input(13, "Jaw Period", min = 1, max = 5000, step = 1)
jawOffset = input(8, "Jaw Offset", min = 0, max = 500, step = 1)
teethPeriod = input(8, "Teeth Period", min = 1, max = 5000, step = 1)
teethOffset = input(5, "Teeth Offset", min = 0, max = 500, step = 1)
lipsPeriod = input(5, "Lips Period", min = 1, max = 5000, step = 1)
lipsOffset = input(3, "Lips Offset", min = 0, max = 500, step = 1)

// Wilder smoothing started from zero, divided by 1 - (1 - a)^k while that
// factor still matters, so the line reads as the source from the first bar
// instead of climbing up from zero.
fn wilderCompensated(src, len) =>
    var smoothed = 0.0
    var e = 1.0
    var warm = true
    a = 1 / len
    result = none
    // A bar with no source value draws nothing and leaves the state as it was.
    if not isNone(src)
        smoothed = a * (src - smoothed) + smoothed
        result = smoothed
        if warm
            e *= 1 - a
            d = 1 - e
            result = d != 0 ? smoothed / d : smoothed
            warm = e > 1e-10
    result

jawRaw = wilderCompensated(source, jawPeriod)
teethRaw = wilderCompensated(source, teethPeriod)
lipsRaw = wilderCompensated(source, lipsPeriod)

// Each line is displaced to the right by its own offset: the value shown on
// a bar is the one computed that many bars earlier.
plot(jawRaw[jawOffset], "Jaw", #2962ff, width = 2)
plot(teethRaw[teethOffset], "Teeth", #f23645, width = 2)
plot(lipsRaw[lipsOffset], "Lips", #26a69a, width = 2)
