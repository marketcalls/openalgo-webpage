version 1
study("MA Envelope (MAE)", overlay = true, precision = 2)

source = input(close, "Source")
length = input(20, "Length", min = 1, max = 5000, step = 1)
percentage = input(1.0, "Percentage", min = 0.001, max = 1000, step = 0.1)
maType = input("EMA", "MA Type", options = ["SMA", "EMA", "WMA"], tooltip = "The average the envelope is built around: SMA, EMA or WMA. EMA is the default.")

// The simple and weighted means read a missing price as zero.
price = orElse(source, 0)

// Simple mean over however many bars exist, up to Length, so the line starts
// on the first bar instead of after a warmup.
partialMean = cum(price) / (bar.index + 1)
fullMean = sma(price, length)
maSma = bar.index < length - 1 ? partialMean : fullMean

// Linear weights, newest weighted Length. Bars before the first one count as
// zero and the total weight is always the full window's, so the early values
// sit below price until the window fills.
weighted = 0.0
norm = 0.0
for j = 0 to length - 1
    weighted = weighted + orElse(price[j], 0) * (length - j)
    norm = norm + (length - j)
maWma = norm > 0 ? weighted / norm : none

// Exponential mean with its warmup compensated: the running weight divides out
// the history that does not exist yet, so it too answers from the first bar.
// A bar with no price is skipped, so one gap does not spoil every later value.
emaAlpha = 2.0 / (length + 1)
var emaSum = 0.0
var emaWeight = 0.0
maEma = none
if not isNone(source)
    emaSum = emaSum * (1.0 - emaAlpha) + source * emaAlpha
    emaWeight = emaWeight * (1.0 - emaAlpha) + emaAlpha
    maEma = emaWeight != 0 ? emaSum / emaWeight : none

middle = maType == "SMA" ? maSma : maType == "WMA" ? maWma : maEma

// Each band sits a fixed percentage of the average away from it.
dist = middle * percentage / 100.0

plot(middle, "Middle", #ffeb3b, width = 2)
top = plot(middle + dist, "Upper", #ffeb3b, width = 2)
bottom = plot(middle - dist, "Lower", #ffeb3b, width = 2)
fill(top, bottom, #2196f3, opacity = 0.1)
