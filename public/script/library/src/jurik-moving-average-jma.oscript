version 1
study("Jurik Moving Average (JMA)", overlay = true, precision = 2)

period = input(10, "Period", min = 1, max = 5000, step = 1, tooltip = "Number of bars used in the calculation.")
phase = input(0, "Phase", min = -100, max = 100, step = 10, tooltip = "Phase shift (-100 to 100). Negative values reduce lag but may cause overshoot.")
power = input(0.45, "Power", min = 0.1, max = 1, step = 0.01, tooltip = "Smoothing factor (0.1-1.0). Lower values create smoother curves.")
source = input(close, "Source")

// Constants fixed by the settings.
phaseValue = min(max(phase * 0.01 + 1.5, 0.5), 2.5)
betaValue = power * (period - 1) / (power * (period - 1) + 2)
// At period 1 the logarithm's argument is 0, and the length term is held at 0.
len1 = period > 1 ? max(log(sqrt(0.5 * (period - 1))) / log(2) + 2, 0) : 0
pow1 = max(len1 - 2, 0.5)
len2 = sqrt(0.5 * (period - 1)) * len1
avgVoltyAlpha = 2 / (max(4 * period, 65) + 1)
divisor = 1 / (10 + 10 * min(max(period - 10, 0), 100) / 100)
rvoltyCap = pow(len1, 1 / pow1)
kvBase = len2 / (len2 + 1)

var upperBand = none
var lowerBand = none
var ma1 = none
var jmaState = none
var avgVolty = none
var vSum = 0.0
var det0 = 0.0
var det1 = 0.0

// Volatility: how far price sits outside the previous adaptive bands, zero
// when it is equally far from both.
del1 = source - orElse(upperBand, source)
del2 = source - orElse(lowerBand, source)
absDel1 = abs(del1)
absDel2 = abs(del2)
volty = absDel1 == absDel2 ? 0 : max(absDel1, absDel2)

// A ten bar running sum of volatility, then its own exponential average.
vSum = vSum + (volty - orElse(volty[10], 0)) * divisor
prevAvgVolty = orElse(avgVolty, vSum)
avgVolty = prevAvgVolty + avgVoltyAlpha * (vSum - prevAvgVolty)

// Relative volatility sets how hard this bar is smoothed.
voltyRatio = avgVolty > 0 ? volty / avgVolty : 1
rvolty = min(max(voltyRatio, 1), rvoltyCap)
pow2 = pow(rvolty, pow1)
kv = pow(kvBase, sqrt(pow2))

upperBand = del1 > 0 ? source : source - kv * del1
lowerBand = del2 < 0 ? source : source - kv * del2

smoothing = pow(betaValue, pow2)
smoothingSquared = smoothing * smoothing
oneMinus = 1 - smoothing
oneMinusSquared = oneMinus * oneMinus

// Three stages: an adaptive average, a phase-shifted lead on it, and a final
// adaptive filter.
prevMa1 = orElse(ma1, source)
ma1 = source + smoothing * (prevMa1 - source)
det0 = (source - ma1) * (1 - betaValue) + betaValue * det0
ma2 = ma1 + phaseValue * det0

prevJma = orElse(jmaState, source)
det1 = (ma2 - prevJma) * oneMinusSquared + smoothingSquared * det1
jmaState = prevJma + det1

plot(jmaState, "JMA", #ffeb3b, width = 2)
