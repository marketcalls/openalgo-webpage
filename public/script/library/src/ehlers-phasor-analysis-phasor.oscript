version 1
study("Ehlers Phasor Analysis (PHASOR)", precision = 2)

period = input(28, "Period", min = 1, max = 5000, step = 1, group = "Phasor Settings")
source = input(close, "Source", group = "Phasor Settings")
showDerivedPeriod = input(false, "Show Derived Period", group = "Optional Plots")
showTrendState = input(false, "Show Trend State Variable", group = "Optional Plots")

n = max(1, floor(period))

// Correlate the last n prices with one cycle of a cosine and of a negative
// sine. A bar before the first one reads as zero, so the early window is zero
// padded. Each sum is built in the order i = 0 to n - 1.
syCos = 0.0
syyCos = 0.0
sySin = 0.0
syySin = 0.0
sx = 0.0
sxx = 0.0
sxyCos = 0.0
sxySin = 0.0
for i = 0 to n - 1
    c = math.cos(2 * math.pi * i / n)
    s = -math.sin(2 * math.pi * i / n)
    syCos += c
    syyCos += c * c
    sySin += s
    syySin += s * s
    x = orElse(source[i], 0)
    sx += x
    sxx += x * x
    sxyCos += x * c
    sxySin += x * s

realPart = 0.0
denCos = (n * sxx - sx * sx) * (n * syyCos - syCos * syCos)
if denCos > 0
    realPart = (n * sxyCos - sx * syCos) / sqrt(denCos)
imagPart = 0.0
denSin = (n * sxx - sx * sx) * (n * syySin - sySin * sySin)
if denSin > 0
    imagPart = (n * sxySin - sx * sySin) / sqrt(denSin)

// The phase of the pair in degrees.
rawPhase = 0.0
if realPart != 0
    rawPhase = 90 - math.atan(imagPart / realPart) * 180 / math.pi
    if realPart < 0
        rawPhase -= 180
else if imagPart != 0
    rawPhase = imagPart > 0 ? 0 : 180

// Unwrap against the previous bar so the angle runs continuously instead of
// jumping a full turn.
var prevUnwrapped = none
var prevFinal = none
var prevDerived = none
if not isNone(prevUnwrapped)
    diff = rawPhase - prevUnwrapped
    if diff > 180
        rawPhase -= 360
    else if diff < -180
        rawPhase += 360
unwrapped = rawPhase

// The angle ratchets: a backward step inside the stated windows is held at the
// previous value rather than followed.
finalPhase = unwrapped
if not isNone(prevFinal) and unwrapped < prevFinal and ((unwrapped > -135 and prevFinal < 135) or (unwrapped < -90 and prevFinal < -90))
    finalPhase = prevFinal

// Derived period: a full turn over this bar's angular step, with the previous
// period reused whenever the step stalls or runs backward, held to 1 to 60.
reference = isNone(prevFinal) ? finalPhase : prevFinal
angleChange = finalPhase - reference
if angleChange == 0 and not isNone(prevDerived)
    angleChange = prevDerived != 0 ? 360 / prevDerived : 0
if angleChange <= 0 and not isNone(prevDerived)
    angleChange = prevDerived != 0 ? 360 / prevDerived : 0
derived = 60.0
if angleChange != 0
    derived = 360 / angleChange
else if not isNone(prevDerived)
    derived = prevDerived
derived = max(1, min(derived, 60))

// Trend state: a near-stalled angle out at the extremes reads as a trend (+1),
// a near-stalled angle in the middle reads as a cycle (-1).
trendState = 0
if finalPhase - reference <= 6
    if finalPhase >= 90 or finalPhase <= -90
        trendState = 1
    else if finalPhase > -90 and finalPhase < 90
        trendState = -1

prevUnwrapped = unwrapped
prevFinal = finalPhase
prevDerived = derived

plot(finalPhase, "Phasor Angle", #ffeb3b, width = 2)
plot(showDerivedPeriod ? derived : none, "Derived Period", #2962ff, width = 2)
plot(showTrendState ? trendState : none, "Trend State", #ff9800, width = 2, style = "histogram")
