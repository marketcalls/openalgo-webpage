version 1
study("Huber Loss (HUBER)", precision = 4)

source = input(close, "Source")
period = input(100, "Period", min = 1, max = 5000, step = 1)
delta = input(1.345, "Delta", min = 0.1, max = 1000, step = 0.001, tooltip = "Threshold where the penalty switches from squared error to absolute error.")

// The reference: an exponential mean of the source, seeded with the simple
// average of its first period values.
reference = ema(source, period)

// Huber penalty of the gap between the source and its mean: squared inside
// delta, linear beyond it.
err = source - reference
absErr = abs(err)
loss = absErr <= delta ? 0.5 * err * err : delta * absErr - 0.5 * delta * delta

// The loss is averaged over the last p bars, counting only the bars that
// have a loss, so the mean answers from the first loss onward.
p = min(max(1, period), 4000)
var lossSum = 0.0
var lossCount = 0
if bar.index >= p and not isNone(loss[p])
    lossSum -= loss[p]
    lossCount -= 1
if not isNone(loss)
    lossSum += loss
    lossCount += 1
huber = lossCount > 0 ? lossSum / lossCount : loss

plot(huber, "Huber", #ff5252, width = 2, style = "area")
plot(reference, "EMA", #ffeb3b, width = 1, overlay = true)
