version 1
study("NMA - Natural Moving Average", overlay = true, precision = 2)

period = input(40, "Period", min = 1, max = 5000, step = 1, tooltip = "Lookback window for the volatility analysis that sets the adaptive smoothing ratio.")
source = input(close, "Source")

// A missing source value is read as zero.
s = orElse(source, 0)

// Scaled natural log of price. Bars before the start of the chart read as
// zero, so on the earliest bars the oldest step is large, which is part of
// the calculation.
lnPrice = s > 0 ? log(s) * 1000 : 0

// Each step in log price is weighted by a square-root kernel: the newest step
// carries the most weight. The ratio of weighted to plain total movement is
// the adaptive smoothing ratio.
num = 0.0
denom = 0.0
steps = min(bar.index + 1, period)
for i = 0 to steps - 1
    stepSize = abs(orElse(lnPrice[i], 0) - orElse(lnPrice[i + 1], 0))
    num += stepSize * (sqrt(i + 1) - sqrt(i))
    denom += stepSize
ratio = denom != 0 ? num / denom : 0

// The average starts at the first source value and then steps toward the
// source by the ratio.
var result = 0.0
result = bar.index == 0 ? s : result + ratio * (s - result)

plot(result, "NMA", #ffeb3b, width = 2)
