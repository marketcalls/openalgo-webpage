version 1
study("Zero-Lag Triple EMA (ZLTEMA)", overlay = true, precision = 2)

period = input(10, "Period", min = 1, max = 5000, step = 1)
source = input(close, "Source")

// The first stage has weight 2 / (period + 1). The second and third stages
// are faster, each weight being the previous one times the cube root of
// 1 / a1, so a2 = a1 ^ (2/3) and a3 = a1 ^ (1/3).
a1 = 2 / (period + 1)
beta1 = 1 - a1
r = pow(1 / a1, 1 / 3)
a2 = a1 * r
a3 = a2 * r
// (period - 1) / 2 rounded down, and never less than one bar: 4 at period 10.
lag = max(1, trunc((period - 1) / 2))

// The de-lagged price: twice this price minus the price `lag` bars ago. Until
// `lag` bars exist the first price of the chart stands in for the older one.
var firstPrice = source
laggedPrice = bar.index >= lag ? source[lag] : firstPrice
deLagged = 2 * source - laggedPrice

// Three exponential averages in a chain, all started from zero. While the
// starting weight e still matters, each stage is multiplied by 1 / (1 - e)
// so the line is usable from the first bar.
var ema1Raw = 0.0
var ema2Raw = 0.0
var ema3Raw = 0.0
var e = 1.0
var warmup = true
ema1Raw = ema1Raw + a1 * (deLagged - ema1Raw)
ema1 = ema1Raw
ema2 = 0.0
ema3 = 0.0
if warmup
    e = e * beta1
    c = 1 - e != 0 ? 1 / (1 - e) : 1
    ema1 = c * ema1Raw
    ema2Raw = ema2Raw + a2 * (ema1 - ema2Raw)
    ema2 = c * ema2Raw
    ema3Raw = ema3Raw + a3 * (ema2 - ema3Raw)
    ema3 = c * ema3Raw
    warmup = e > 1e-10
else
    ema2Raw = ema2Raw + a2 * (ema1 - ema2Raw)
    ema2 = ema2Raw
    ema3Raw = ema3Raw + a3 * (ema2 - ema3Raw)
    ema3 = ema3Raw

zltema = 3 * ema1 - 3 * ema2 + ema3

plot(zltema, "ZLTEMA", #ffeb3b, width = 2)
