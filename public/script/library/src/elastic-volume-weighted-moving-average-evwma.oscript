version 1
study("Elastic Volume Weighted Moving Average (EVWMA)", overlay = true, precision = 2)

period = input(20, "Period", min = 1, max = 5000, step = 1)
source = input(close, "Source")

len = max(1, floor(period))

// Volume over the last len bars, counting the early bars as they arrive. A
// missing or negative volume counts as zero.
curVol = max(orElse(volume, 0), 0)
curPrice = orElse(source, 0)
var sumVol = 0.0
if bar.index >= len
    sumVol -= curVol[len]
sumVol += curVol

// The average starts at the first price. Each later bar pulls it toward price
// by that bar's share of the window's volume; a window with no volume holds it.
var result = none
if isNone(result)
    result = curPrice
else if sumVol > 0
    result = ((sumVol - curVol) * result + curVol * curPrice) / sumVol

plot(result, "EVWMA", #ffeb3b, width = 2)
