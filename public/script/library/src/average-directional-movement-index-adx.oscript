version 1
study("Average Directional Movement Index (ADX)", precision = 2)

period = input(14, "Period", min = 1, max = 5000, step = 1, tooltip = "Bars in each of Wilder's averages.")

// Wilder's definition: true range and the up and down directional movement
// are each smoothed with Wilder's average, giving +DI and -DI; DX is their
// difference over their sum, and ADX is Wilder's average of DX.
dmi = adx(period, period)
adxValue = dmi[0]
plusDi = dmi[1]
minusDi = dmi[2]

plot(adxValue, "ADX", #ffeb3b, width = 2)
plot(plusDi, "+DI", #4caf50, width = 2)
plot(minusDi, "-DI", #ff5252, width = 2)
