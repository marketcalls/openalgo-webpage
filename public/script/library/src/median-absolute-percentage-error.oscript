version 1
study("Median Absolute Percentage Error", precision = 2)

length = input(14, "Length", min = 1, max = 5000, step = 1)
actual = input(close, "Actual")
predicted = input(open, "Predicted")

epsilon = 1e-10

// The scale reads an absent actual as one and the gap reads it as zero, so a
// missing bar contributes a zero error rather than a gap.
absActual = abs(orElse(actual, 1))
absError = abs(orElse(actual, 0) - orElse(predicted, 0))
pctError = absActual > epsilon ? absError / absActual * 100 : 0

// The last length errors, oldest first.
var window: array<number> = []
push(window, pctError)
if size(window) > length
    shift(window)

// The median by nearest rank: the value at position ceil(length / 2) of the
// sorted window, so an even window answers one of its own members rather
// than the mean of the middle two.
mdape = none
if size(window) == length
    sorted = copy(window)
    sort(sorted, "asc")
    rank = max(1, ceil(0.5 * length))
    mdape = element(sorted, rank - 1)

plot(mdape, "MdAPE", #ffeb3b, width = 2)
level(0, "Zero", #9e9e9e, style = "dashed")
