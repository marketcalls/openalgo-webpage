version 1
study("Mean Absolute %Deviation (MAPD)", precision = 2)

source = input(close, "Source")
period = input(100, "Period", min = 1, max = 5000, step = 1, tooltip = "Lookback for the reference EMA and for averaging the error. The averaging window is capped at 4000 bars.")

// The reference is an exponential mean seeded with the simple average of its
// first `period` values, so it has no value through the warmup.
reference = ema(source, period)

// The distance from the reference as a percentage of the reference. A zero
// reference leaves the error absent rather than infinite.
pctDev = reference != 0 ? 100 * abs((source - reference) / reference) : none

// Averaged over the last `period` bars, at most 4000, counting only the bars
// that carry an error.
window = min(period, 4000)
mapd = avgSkip(pctDev, window)

plot(mapd, "MAPD", #ff525266, width = 2, style = "area")
plot(reference, "EMA", #ffeb3b, width = 1, overlay = true)
