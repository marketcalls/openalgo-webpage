version 1
study("SuperTrend", overlay = true, precision = 2)

atrPeriod = input(10, "ATR Period", min = 1, max = 100, step = 1)
multiplier = input(3, "Multiplier", min = 0.1, max = 100, step = 0.1)
// Kept as a setting for compatibility; the bands are built from the high,
// low and close whatever it is set to.
source = input(close, "Source")

// The previous close, read as zero on the first bar.
prevClose = orElse(close[1], 0)
tr = max(high - low, max(abs(high - prevClose), abs(low - prevClose)))

// Wilder average of the true range started from zero and divided by
// 1 - (1 - a)^k while that factor still matters.
a = 1.0 / atrPeriod
var atrState = 0.0
var e = 1.0
var warm = true
atrState = a * (tr - atrState) + atrState
atrValue = atrState
if warm
    e *= 1.0 - a
    denom = 1.0 - e
    atrValue = (denom > 0 ? 1.0 / denom : 1.0) * atrState
    warm = e > 1e-10

basicUb = hl2 + multiplier * atrValue
basicLb = hl2 - multiplier * atrValue

// The bands only tighten toward price, unless the previous close broke
// through them, in which case they reset to the basic band.
var finalUb = none
var finalLb = none
if isNone(finalUb)
    finalUb = basicUb
    finalLb = basicLb
finalUb = basicUb < finalUb or prevClose > finalUb ? basicUb : finalUb
finalLb = basicLb > finalLb or prevClose < finalLb ? basicLb : finalLb

var dir = 1
dir = close > finalUb ? 1 : close < finalLb ? -1 : dir
line = dir == 1 ? finalLb : finalUb

plot(line, "SuperTrend", dir == 1 ? #4caf50 : #ff5252, width = 2)

// A mark wherever the direction changes; the first bar always counts.
turned = dir != orElse(dir[1], 0)
signal(turned and dir == 1 ? "BUY" : none, color = #4caf50, at = "below", shape = "label")
signal(turned and dir == -1 ? "SELL" : none, color = #ff5252, at = "above", shape = "label")
