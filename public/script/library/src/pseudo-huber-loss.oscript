version 1
study("Pseudo-Huber Loss", precision = 4)

length = input(14, "Length", min = 1, max = 5000, step = 1)
delta = input(1, "Delta (transition scale)", min = 0.001, max = 100000, step = 0.1, tooltip = "Controls transition between quadratic and linear behavior")
actual = input(close, "Actual")
predicted = input(open, "Predicted")

// An absent value on either side counts as zero.
a = orElse(actual, 0)
p = orElse(predicted, 0)

// The smooth form of the Huber loss: close to half the squared error for
// small misses and close to delta times the absolute error for large ones.
deltaSquared = delta * delta
ratio = (a - p) / delta
loss = deltaSquared * (sqrt(1.0 + ratio * ratio) - 1.0)

plot(sma(loss, length), "Pseudo-Huber", #ffeb3b, width = 2)
level(0, "Zero", #787b86, style = "solid")
