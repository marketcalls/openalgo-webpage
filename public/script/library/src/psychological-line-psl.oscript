version 1
study("Psychological Line (PSL)", precision = 2, range = [0, 100])

period = input(12, "Period", min = 1, max = 5000, step = 1)
source = input(close, "Source")

// 1 on a bar that closed above the previous one, 0 otherwise.
upFlag = not isNone(source[1]) and not isNone(source) and source > source[1] ? 1 : 0

// The count of up bars over the last period bars, or over every bar so far
// while fewer than period have been seen.
var upSum = 0
var seen = 0
if bar.index >= period
    upSum -= upFlag[period]
else
    seen += 1
upSum += upFlag

psl = 100 * upSum / max(1, seen)

plot(psl, "PSL", #ffeb3b, width = 2)
level(50, "Midline", #787b86, style = "dashed")
level(75, "Overbought", #ff5252, style = "dashed")
level(25, "Oversold", #4caf50, style = "dashed")
