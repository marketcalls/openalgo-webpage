version 1
study("Harmonic Mean (HARMEAN)", precision = 2)

source = input(close, "Source (must be positive values)")
length = input(14, "Lookback Period", min = 1, max = 5000, step = 1)

// A running sum of the reciprocals of the positive values in the last
// `length` bars, and how many there are. The value entering is added and the
// value leaving the window is taken out, so the window grows over the first
// `length` bars and then slides.
var sumReciprocal = 0.0
var nValid = 0

leaving = orElse(source[length], 0)
if leaving > 0
    sumReciprocal -= 1 / leaving
    nValid -= 1

entering = orElse(source, 0)
if entering > 0
    sumReciprocal += 1 / entering
    nValid += 1

// The count divided by the sum of reciprocals.
harmean = nValid > 0 and sumReciprocal > 1e-10 ? nValid / sumReciprocal : none

plot(harmean, "HARMEAN", #ffeb3b, width = 2)
