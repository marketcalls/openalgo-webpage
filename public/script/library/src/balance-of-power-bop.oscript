version 1
study("Balance of Power (BOP)", precision = 4)

smoothing = input(14, "Smoothing Length", min = 0, max = 5000, step = 1, tooltip = "0 for no smoothing.")

len = max(0, floor(smoothing))

// Where the close finished inside the bar's range; a bar with no range is 0.
rawBop = high == low ? 0 : (close - open) / (high - low)

// An exponential mean seeded with the first value. While it warms it is
// multiplied by 1 / (1 - e), where e is (1 - weight) raised to the number of
// updates so far; once e falls below 1e-10 the factor is dropped.
weight = 2 / (len + 1)
var smoothBop = none
var e = 1.0
var warmupComplete = false

bop = rawBop
if len > 0
    if isNone(smoothBop)
        smoothBop = rawBop
        bop = rawBop
    else
        smoothBop = weight * (rawBop - smoothBop) + smoothBop
        if not warmupComplete
            e = e * (1 - weight)
            c = e > 1e-10 ? 1 / (1 - e) : 1
            bop = smoothBop * c
            if e <= 1e-10
                warmupComplete = true
        else
            bop = smoothBop

plot(bop, "BOP", #ffeb3b, width = 2)
