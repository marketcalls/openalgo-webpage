version 1
study("Root Mean Squared Error (RMSE)", precision = 2)

source = input(close, "Source")
period = input(100, "Period", min = 1, max = 4000, step = 1)

// The reference is an exponential mean seeded with the simple average of its
// first period values, so it has no value through the warmup.
reference = ema(source, period)

// The squared gap between price and its reference, absent until the
// reference exists.
squaredError = (source - reference) * (source - reference)

// Mean of the squared gaps over the last period bars (at most 4000), counting
// only the bars that carry one, then its square root.
window = min(period, 4000)
mse = avgSkip(squaredError, window)
rmse = mse >= 0 ? sqrt(mse) : none

plot(rmse, "RMSE", #ff5252, width = 2, style = "area")
plot(reference, "EMA", #ffeb3b, width = 1, overlay = true)
