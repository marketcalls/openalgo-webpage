version 1
study("TYPPRICE: Typical Price", overlay = true, precision = 2)

// The plain average of the bar's high, low and close. One value per bar,
// with no warmup.
typPrice = (high + low + close) / 3

plot(typPrice, "TypPrice", #4caf50, width = 2)
