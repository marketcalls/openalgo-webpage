version 1
study("Non-Lag Moving Average (NLMA)", overlay = true, precision = 2)

period = input(14, "Period", min = 2, max = 200, step = 1, tooltip = "Conceptual averaging period. The kernel itself spans 5 * period - 1 bars.")
source = input(close, "Source")

phase = period - 1
cycle = 4
flen = period * 4 + phase
coeff = 3 * math.pi

// The kernel, built once. Weight k multiplies the bar k bars back. The first
// phase taps ramp t from 0 to 1, the rest carry t on upward, and each tap is
// cos(pi * t), damped by 1 / (3 pi t + 1) once t passes one half. The last
// tap is left at zero.
var weights: array<number> = []
var weightSum = 0.0
if bar.isFirst
    for i = 0 to flen - 1
        w = 0.0
        if i <= flen - 2
            t = 0.0
            if i <= phase - 1
                t = phase > 1 ? i / (phase - 1) : 0
            else
                numer = (i - phase + 1) * (2 * cycle - 1)
                denom = cycle * period - 1
                t = 1 + (denom > 0 ? numer / denom : 0)
            beta = math.cos(math.pi * t)
            g = t <= 0.5 ? 1 : 1 / (coeff * t + 1)
            w = g * beta
            weightSum += w
        push(weights, w)

// An absent price counts as zero.
price = orElse(source, 0)

// The weights are normalised by their sum, so a flat price passes through
// unchanged. Until the kernel has a full window the line shows the price.
filtered = 0.0
if bar.index + 1 >= flen
    for k = 0 to flen - 1
        filtered += orElse(source[k], 0) * element(weights, k)
usable = abs(weightSum) > 1e-15
nlma = bar.index + 1 < flen ? price : usable ? filtered / weightSum : price

plot(nlma, "NLMA", #ffeb3b, width = 2)
