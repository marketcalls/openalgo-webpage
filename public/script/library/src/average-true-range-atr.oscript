version 1
study("Average True Range (ATR)", precision = 2)

length = input(14, "Length", min = 1, max = 5000, step = 1, tooltip = "Number of bars used for the ATR calculation.")

// True range against the previous close. The first bar compares against its
// own close, so its range is high minus low.
prevClose = bar.index > 0 ? close[1] : close
tr = max(max(high - low, abs(high - prevClose)), abs(low - prevClose))

// A running average with weight 1 / length, started from zero. Dividing by
// (1 - e), where e is the weight still held by the zero start, removes that
// bias so the line is usable from the first bar.
var rawRma = 0.0
var e = 1.0
beta = 1 - 1 / length
rawRma = (rawRma * (length - 1) + tr) / length
e = e * beta
atrValue = e > 1e-10 ? rawRma / (1 - e) : rawRma

plot(atrValue, "ATR", #ffeb3b, width = 2)
