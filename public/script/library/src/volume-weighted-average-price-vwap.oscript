version 1
study("Volume Weighted Average Price (VWAP)", overlay = true, precision = 2)

source = input(hlc3, "Source")
sessionType = input("1D", "Session Reset", options = ["1m", "2m", "3m", "5m", "10m", "15m", "30m", "45m", "1H", "2H", "3H", "4H", "1D", "1W", "1M", "3M", "6M", "12M", "Never"])

// The first bar of each trading session, or of each calendar day where the
// host states no session hours.
newSession = orElse(session.isFirstBar, bar.isFirst or not date.isSameDay(time, time[1]))
var sessionOpen = time
if newSession
    sessionOpen = time

// Intraday resets split each session into buckets of the chosen length,
// counted from the session's first bar, and also start again with each new
// session. Longer resets follow the calendar in the chart's own timezone:
// weeks start on Monday, and "Never" accumulates from the first bar.
minutes = sessionType == "1m" ? 1 : sessionType == "2m" ? 2 : sessionType == "3m" ? 3 : sessionType == "5m" ? 5 : sessionType == "10m" ? 10 : sessionType == "15m" ? 15 : sessionType == "30m" ? 30 : sessionType == "45m" ? 45 : sessionType == "1H" ? 60 : sessionType == "2H" ? 120 : sessionType == "3H" ? 180 : sessionType == "4H" ? 240 : 0
bucket = minutes > 0 ? floor((time - sessionOpen) / (minutes * 60000)) : 0
dayIndex = round(date.startOfDay(time) / 86400000)
periodKey = sessionType == "1D" ? dayIndex : sessionType == "1W" ? floor((dayIndex + 3) / 7) : sessionType == "1M" ? date.year(time) * 12 + date.month(time) : sessionType == "3M" ? date.year(time) * 4 + floor((date.month(time) - 1) / 3) : sessionType == "6M" ? date.year(time) * 2 + (date.month(time) > 6 ? 1 : 0) : sessionType == "12M" ? date.year(time) : 0
reset = bar.index == 0 or (minutes > 0 ? newSession or bucket != bucket[1] : periodKey != periodKey[1])

// A missing price or volume is read as zero.
price = orElse(source, 0)
vol = orElse(volume, 0)

// Running volume weighted sums since the last reset. A bar with no volume
// adds nothing.
var sumPv = 0.0
var sumVol = 0.0
if reset
    sumPv = vol > 0 ? price * vol : 0.0
    sumVol = vol > 0 ? vol : 0.0
else if vol > 0
    sumPv += price * vol
    sumVol += vol

// With no volume yet in the period the line falls back to the source itself.
plot(sumVol > 0 ? sumPv / sumVol : source, "VWAP", #ffeb3b, width = 2)
