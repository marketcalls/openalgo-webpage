version 1
study("Liquidity Void Fill", overlay = true, precision = 2)

// ---- Liquidity void -------------------------------------------------------------
showLong = input(true, "Long Signals", group = "Liquidity Void")
showShort = input(true, "Short Signals", group = "Liquidity Void")
fibValue = input(0.5, "Fib Value", min = 0, max = 1, step = 0.1, group = "Liquidity Void", tooltip = "0 is the bottom of a bullish candle and the top of a bearish one, 1 is the opposite edge, 0.5 is the midpoint. Other Fibonacci or OTE values such as 0.62, 0.705 and 0.79 are usable.")
lineStyle = input("solid", "Line Style", options = ["solid", "dashed", "dotted"], group = "Liquidity Void")

// ---- Additional filters ---------------------------------------------------------
atrFilter = input(true, "Apply ATR Filter", group = "Additional Filters", tooltip = "Applies only to the displacement candle. A higher multiplier demands a longer, more volatile candle.")
atrLength = input(14, "ATR Length", min = 1, max = 5000, step = 1, group = "Additional Filters")
atrMulti = input(1, "ATR Multiplier", min = 1, max = 100, step = 0.1, group = "Additional Filters")

bodyFilter = input(true, "Apply Body % Filter", group = "Additional Filters", tooltip = "Applies only to the displacement candle. At 80, the body covers over 80 per cent of the candle total length.")
bodyPercent = input(80, "Body % Above", min = 0, max = 100, step = 1, group = "Additional Filters")

bodySizeFilter = input(false, "Apply Body Size Filter", group = "Additional Filters", tooltip = "Applies only to the displacement candle. At 2, the candle is twice the size of the previous candle.")
bodySizeMultiplier = input(2, "Body Size Multiplier (x)", min = 0, max = 100, step = 1, group = "Additional Filters")

timeFilter = input(false, "Apply Time Filter", group = "Additional Filters", tooltip = "Applies only to the retracement candle. Keeps signals inside the window below.")
hourFrom = input(9, "Time From (hour)", min = 0, max = 23, step = 1, group = "Additional Filters")
minuteFrom = input(15, "Time From (minute)", min = 0, max = 59, step = 1, group = "Additional Filters")
hourTo = input(10, "Time To (hour)", min = 0, max = 23, step = 1, group = "Additional Filters")
minuteTo = input(15, "Time To (minute)", min = 0, max = 59, step = 1, group = "Additional Filters")

dateFilter = input(false, "Apply Date Filter", group = "Additional Filters", tooltip = "Applies only to the retracement candle. Keeps signals on the single date below.")
day = input(13, "Day", min = 1, max = 31, step = 1, group = "Additional Filters")
month = input(3, "Month", min = 1, max = 12, step = 1, group = "Additional Filters")
year = input(2025, "Year", min = 0, max = 9999, step = 1, group = "Additional Filters")

POS = #089981
POS_LIGHT = #ACE5DC
NEG_LIGHT = #FCCBCD
NEG = #F23645

// At most this many fill lines are kept, newest first.
MAX_LINES = 500

// ---- Displacement candle filters ------------------------------------------------
// Each filter passes when it is switched off and only narrows when it is on.
barRange = high - low
bodyShare = barRange > 0 ? abs(close - open) / barRange : none
wideBody = not isNone(bodyShare) and bodyShare >= bodyPercent / 100

// The average true range is absent through its warmup, and the filter blocks
// rather than passes there.
atrV = atr(atrLength)
atrPass = not atrFilter or (not isNone(atrV) and barRange > atrV * atrMulti)
bodyPass = not bodyFilter or wideBody
prevRange = high[1] - low[1]
bodySizePass = not bodySizeFilter or (wideBody and not isNone(prevRange) and barRange >= prevRange * bodySizeMultiplier)
filtersPass = atrPass and bodyPass and bodySizePass

// A bearish or bullish displacement candle.
shortCont1 = open > close and filtersPass
longCont1 = open < close and filtersPass

// ---- Retracement filters, on the chart's clock -----------------------------------
barHour = date.hour(time)
barMinute = date.minute(time)
timePass = not timeFilter or ((barHour > hourFrom or (barHour == hourFrom and barMinute >= minuteFrom)) and (barHour < hourTo or (barHour == hourTo and barMinute < minuteTo)))
datePass = not dateFilter or (date.year(time) == year and date.month(time) == month and date.day(time) == day)

// ---- The void levels ---------------------------------------------------------------
// The newest displacement candle of each side, and the bar it printed on.
var shortHigh = none
var shortLow = none
var shortAnchor = none
var longHigh = none
var longLow = none
var longAnchor = none

if shortCont1
    shortHigh = high
    shortLow = low
    shortAnchor = time
if longCont1
    longHigh = high
    longLow = low
    longAnchor = time

// The bearish level is measured down from the candle's high, the bullish one up
// from the candle's low.
bearFib = isNone(shortHigh) ? none : shortHigh - (shortHigh - shortLow) * fibValue
bullFib = isNone(longLow) ? none : longLow + (longHigh - longLow) * fibValue

// The high crosses up through the bearish level, the low crosses down through
// the bullish one, with both bars and both levels present.
crossOver = not isNone(bearFib) and not isNone(bearFib[1]) and not isNone(high[1]) and high > bearFib and high[1] <= bearFib[1]
crossUnder = not isNone(bullFib) and not isNone(bullFib[1]) and not isNone(low[1]) and low < bullFib and low[1] >= bullFib[1]

// Only a closed bar may signal: a bar still forming under a moving feed never
// fires.
confirmed = bar.isConfirmed or not bar.isRealtime
shortCont2 = crossOver and timePass and datePass and confirmed
longCont2 = crossUnder and timePass and datePass and confirmed

// Two steps: arm on the displacement candle, fire on the retracement, and
// clear on the bar after the signal.
var shortState = 0
var longState = 0

shortState = shortState == 2 ? 0 : shortState
if shortCont1 and shortState == 0
    shortState = 1
if not shortCont1 and shortCont2 and shortState == 1
    shortState = 2

longState = longState == 2 ? 0 : longState
if longCont1 and longState == 0
    longState = 1
if not longCont1 and longCont2 and longState == 1
    longState = 2

shortSignal = shortState == 2
longSignal = longState == 2

// ---- Markers, candle colours and fill lines --------------------------------------------
signal(showShort and shortSignal ? "Short" : none, color = #FCCBCD, at = "above", shape = "triangleDown")
signal(showLong and longSignal ? "Long" : none, color = #ACE5DC, at = "below", shape = "triangleUp")

// The displacement candle itself is repainted, the bearish one first.
barColor(showShort and shortCont1 ? NEG_LIGHT : showLong and longCont1 ? POS_LIGHT : none)

// The filled level, drawn from the displacement candle to the signal bar.
var fillLines: array<line> = []
if showShort and shortSignal and not isNone(bearFib) and not isNone(shortAnchor)
    push(fillLines, draw.line(shortAnchor, bearFib, time, bearFib, color = NEG, width = 1, style = lineStyle))
if showLong and longSignal and not isNone(bullFib) and not isNone(longAnchor)
    push(fillLines, draw.line(longAnchor, bullFib, time, bullFib, color = POS, width = 1, style = lineStyle))
while size(fillLines) > MAX_LINES
    draw.delete(shift(fillLines))

// The chart draws a study's markers and bar colours only when the study has
// a plot, so one fully transparent column carries them. It shows nothing.
plot(close, "Marker Anchor", rgba(0, 0, 0, 0))
