version 1
study("Ichimoku Cloud", overlay = true, precision = 2)

tenkan = input(9, "Tenkan Period", min = 1, max = 5000, step = 1)
kijun = input(26, "Kijun Period", min = 1, max = 5000, step = 1)
senkouB = input(52, "Senkou B Period", min = 1, max = 5000, step = 1)
displacement = input(26, "Displacement", min = 1, max = 500, step = 1, tooltip = "Bars the cloud is pushed forward and the lagging span pulled back by.")

// The midpoint of the highest high and lowest low over the last `len` bars.
// On the first bars the window is every bar so far, so each line answers
// from the first bar.
fn midpoint(len) =>
    win = min(bar.index + 1, len)
    hi = high
    lo = low
    for k = 1 to win - 1
        hi = max(hi, high[k])
        lo = min(lo, low[k])
    (hi + lo) / 2

tenkanLine = midpoint(tenkan)
kijunLine = midpoint(kijun)
spanBLine = midpoint(senkouB)
spanALine = (tenkanLine + kijunLine) / 2

// The leading spans are shown `displacement` bars after the bar that
// computed them, on the bars that exist.
leadA = spanALine[displacement]
leadB = spanBLine[displacement]

plot(tenkanLine, "Tenkan-sen", #2962ff, width = 1)
plot(kijunLine, "Kijun-sen", #ff5252, width = 1)
// The lagging span is the close drawn 26 bars back. A plot offset takes an
// input only as the whole of its value, and this one would need the input
// negated, so it stays at the default distance.
plot(close, "Chikou Span", #9c27b0, width = 1, offset = -26)
spanA = plot(leadA, "Senkou Span A", #4caf50, width = 1)
spanB = plot(leadB, "Senkou Span B", #ff5252, width = 1)
// Green where span A leads, red where span B does.
fill(spanA, spanB, leadA > leadB ? #4caf50 : #ff5252, opacity = 0.1)
